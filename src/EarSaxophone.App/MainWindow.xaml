<ui:FluentWindow x:Class="EarSaxophone.App.MainWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:local="clr-namespace:EarSaxophone.App"
                  xmlns:loc="clr-namespace:EarSaxophone.Core.Localization;assembly=EarSaxophone.Core"
                  Title="Ear Saxophone"
                  Width="780" Height="330" MinWidth="640" MinHeight="290"
                  WindowStartupLocation="CenterScreen"
                  ExtendsContentIntoTitleBar="True"
                  WindowBackdropType="None"
                  FontSize="13" FontFamily="{DynamicResource UiFont}"
                  Background="{DynamicResource ApplicationBackgroundBrush}"
                  Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelLearnCommand}" />
    </ui:FluentWindow.InputBindings>

    <ui:FluentWindow.Resources>
        <!-- Kleines Symbol der Belegung (Art der ersten Aktion, Zahl bei mehreren Aktionen) -->
        <ControlTemplate x:Key="BadgeTemplate" TargetType="ContentControl">
            <Border x:Name="BadgeRoot" Height="20" MinWidth="20" CornerRadius="{DynamicResource ControlRadius}" Padding="4,0" Background="{DynamicResource AccentBrush}"
                    BorderBrush="#1B1C1F" BorderThickness="1.5" AutomationProperties.AutomationId="Badge"
                    Visibility="{Binding HasMapping, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="{Binding BadgeKind, Converter={StaticResource KindSymbol}}" FontSize="12" Filled="True"
                                   Foreground="{DynamicResource OnAccentBrush}" />
                    <TextBlock Text="{Binding ActionCount}" FontSize="11" FontWeight="Bold" Margin="2,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource OnAccentBrush}" AutomationProperties.AutomationId="BadgeCount"
                               Visibility="{Binding ShowsActionCount, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>
        </ControlTemplate>

        <!-- Jedes Element im Bild: anklicken = wählen, belegtes Element ziehen = verschieben/tauschen (Strg = kopieren) -->
        <Style x:Key="ElementButton" TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="AllowDrop" Value="True" />
            <Setter Property="Width" Value="{Binding Width}" />
            <Setter Property="Height" Value="{Binding Height}" />
            <Setter Property="ToolTip" Value="{Binding TooltipText}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
            <Setter Property="AutomationProperties.HelpText" Value="{Binding Summary}" />
            <Setter Property="Command" Value="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="CommandParameter" Value="{Binding}" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Element_PreviewMouseLeftButtonDown" />
            <EventSetter Event="PreviewMouseMove" Handler="Element_PreviewMouseMove" />
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="Element_PreviewMouseLeftButtonUp" />
            <EventSetter Event="DragEnter" Handler="Element_DragOver" />
            <EventSetter Event="DragOver" Handler="Element_DragOver" />
            <EventSetter Event="DragLeave" Handler="Element_DragLeave" />
            <EventSetter Event="Drop" Handler="Element_Drop" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Hover" CornerRadius="14" Margin="-4" Background="Transparent" />
                            <Border x:Name="Ring" CornerRadius="14" Margin="-4" BorderThickness="2" BorderBrush="{DynamicResource AccentBrush}"
                                    Background="#263FB6A8" Opacity="0" />
                            <Rectangle x:Name="DropRing" Margin="-6" RadiusX="15" RadiusY="15" Stroke="{DynamicResource AccentStrongBrush}"
                                       StrokeThickness="2" StrokeDashArray="3 2" Fill="#333FB6A8" Visibility="Collapsed" />
                            <ContentPresenter />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Background" Value="#1CFFFFFF" />
                            </Trigger>
                            <Trigger Property="local:DropTarget.IsActive" Value="True">
                                <Setter TargetName="DropRing" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Drehregler: schwarzer Knopf wie am Gerät mit heller Markierung (dreht live mit), feine Skalenpunkte außen -->
        <DataTemplate x:Key="KnobTemplate">
            <Button Style="{StaticResource ElementButton}">
                <Grid>
                    <Ellipse Width="48" Height="48" Stroke="#59FFFFFF" StrokeThickness="1.5" StrokeDashArray="0.4 4" StrokeDashCap="Round"
                             IsHitTestVisible="False" />
                    <Ellipse Width="40" Height="40" Fill="#050506" Stroke="#3A3C42" StrokeThickness="1">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="7" ShadowDepth="3" Opacity="0.8" Color="Black" />
                        </Ellipse.Effect>
                    </Ellipse>
                    <Ellipse Width="36" Height="36" Fill="{DynamicResource KnobBrush}" Stroke="#4A4D55" StrokeThickness="1" />
                    <Ellipse Width="26" Height="26" Stroke="#22FFFFFF" StrokeThickness="1" IsHitTestVisible="False" />
                    <Grid Width="36" Height="36" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <RotateTransform Angle="{Binding KnobAngle}" />
                        </Grid.RenderTransform>
                        <Border Width="3" Height="13" Margin="0,2,0,0" VerticalAlignment="Top" HorizontalAlignment="Center"
                                CornerRadius="1.5" Background="{DynamicResource KnobMarkBrush}" />
                    </Grid>
                    <ContentControl Template="{StaticResource BadgeTemplate}" Focusable="False" IsHitTestVisible="False"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-8,0" />
                </Grid>
            </Button>
        </DataTemplate>

        <!-- Fader: heller Schlitz wie am Gerät, schwarze Kappe mit Rillen (fährt live mit), Kanalnummer darunter -->
        <DataTemplate x:Key="FaderTemplate">
            <Button Style="{StaticResource ElementButton}">
                <Grid>
                    <Border Width="18" HorizontalAlignment="Center" Margin="0,2,0,20" CornerRadius="3"
                            Background="{DynamicResource SlotBrush}" BorderBrush="#2A2B2F" BorderThickness="1">
                        <Rectangle Width="3" Margin="0,4" Fill="#55000000" />
                    </Border>
                    <Border Width="28" Height="40" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0" CornerRadius="3"
                            Background="{DynamicResource FaderCapBrush}" BorderBrush="#000000" BorderThickness="1">
                        <Border.RenderTransform>
                            <TranslateTransform Y="{Binding CapOffset}" />
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="3" Opacity="0.8" Color="Black" />
                        </Border.Effect>
                        <StackPanel VerticalAlignment="Center" IsHitTestVisible="False">
                            <Rectangle Height="2" Margin="3,0,3,4" Fill="#3A3C42" />
                            <Rectangle Height="2" Margin="3,0,3,4" Fill="#3A3C42" />
                            <Rectangle Height="2" Margin="3,0,3,4" Fill="#E8E9EC" />
                            <Rectangle Height="2" Margin="3,0,3,4" Fill="#3A3C42" />
                            <Rectangle Height="2" Margin="3,0" Fill="#3A3C42" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding Caption}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,1" FontSize="12"
                               FontWeight="SemiBold" Foreground="{DynamicResource PrintSoftBrush}" IsHitTestVisible="False" />
                    <ContentControl Template="{StaticResource BadgeTemplate}" Focusable="False" IsHitTestVisible="False"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-12,-10,0" />
                </Grid>
            </Button>
        </DataTemplate>

        <!-- Taste wie am Gerät: dunkle Fläche mit weißem Aufdruck. Tasten mit LED haben einen rötlichen Leuchtrand; bei Stumm
             (IsMuteLit) leuchtet er hell und die Fläche färbt sich rot. Gedrückt = heller. -->
        <DataTemplate x:Key="KeyTemplate">
            <Button Style="{StaticResource ElementButton}">
                <Grid>
                    <Border x:Name="Key" CornerRadius="{DynamicResource KeyRadius}" Margin="1" Background="{DynamicResource KeyBrush}"
                            BorderBrush="{DynamicResource KeyEdgeBrush}" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="2" Opacity="0.7" Color="Black" />
                        </Border.Effect>
                    </Border>
                    <Border x:Name="KeyGlow" CornerRadius="{DynamicResource KeyRadius}" Margin="1" Background="#40FF5A4A" Opacity="0" IsHitTestVisible="False" />
                    <Border x:Name="Led" CornerRadius="{DynamicResource KeyRadius}" Margin="1" BorderThickness="1.5" BorderBrush="{DynamicResource LedOffBrush}"
                            IsHitTestVisible="False" AutomationProperties.AutomationId="KeyLed"
                            Visibility="{Binding HasLed, Converter={StaticResource BoolToVis}}" />
                    <Border x:Name="LedOn" CornerRadius="{DynamicResource KeyRadius}" Margin="1" BorderThickness="1.5" BorderBrush="{DynamicResource LedOnBrush}"
                            IsHitTestVisible="False" AutomationProperties.AutomationId="KeyLedOn" Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.9" Color="#FF5A4A" />
                        </Border.Effect>
                    </Border>
                    <TextBlock x:Name="GlyphText" Text="{Binding Glyph}" Foreground="{DynamicResource KeyGlyphBrush}" FontSize="13" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <ContentControl Template="{StaticResource BadgeTemplate}" Focusable="False" IsHitTestVisible="False"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-7,-7,0" />
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <!-- flache Tasten (TRACK, CYCLE, MARKER): Pillenform, kleine Schrift -->
                <DataTrigger Binding="{Binding Height}" Value="22">
                    <Setter TargetName="Key" Property="CornerRadius" Value="11" />
                    <Setter TargetName="Led" Property="CornerRadius" Value="11" />
                    <Setter TargetName="LedOn" Property="CornerRadius" Value="11" />
                    <Setter TargetName="KeyGlow" Property="CornerRadius" Value="11" />
                    <Setter TargetName="GlyphText" Property="FontSize" Value="9" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Height}" Value="36">
                    <Setter TargetName="GlyphText" Property="FontSize" Value="14" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMuteLit}" Value="True">
                    <Setter TargetName="LedOn" Property="Visibility" Value="Visible" />
                    <Setter TargetName="KeyGlow" Property="Opacity" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasLed}" Value="False">
                    <Setter TargetName="LedOn" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <!-- Blinken bei Stumm: in der dunklen Phase bleibt KeyLedOn sichtbar (IsMuteLit), wird aber ausgeblendet (Opacity). -->
                <DataTrigger Binding="{Binding IsLedBlinkOff}" Value="True">
                    <Setter TargetName="LedOn" Property="Opacity" Value="0" />
                    <Setter TargetName="KeyGlow" Property="Opacity" Value="0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="Key" Property="Background" Value="{DynamicResource KeyActiveBrush}" />
                    <Setter TargetName="Key" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Per MIDI-Learn gefundene Regler, die nicht im Bild sind -->
        <DataTemplate x:Key="ExtraTemplate">
            <Button Style="{StaticResource ElementButton}" Margin="0,0,12,8">
                <Grid>
                    <Border x:Name="Key" CornerRadius="{DynamicResource ControlRadius}" Background="{DynamicResource KeyBrush}" BorderBrush="#5A647F" BorderThickness="1" Padding="10,0,28,0">
                        <TextBlock Text="{Binding Label}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Border>
                    <ContentControl Template="{StaticResource BadgeTemplate}" Focusable="False" IsHitTestVisible="False"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" />
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="Key" Property="Background" Value="{DynamicResource KeyActiveBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <local:ElementTemplateSelector x:Key="ElementSelector" Knob="{StaticResource KnobTemplate}"
                                       Fader="{StaticResource FaderTemplate}" Button="{StaticResource KeyTemplate}" />
    </ui:FluentWindow.Resources>

    <Grid Background="{DynamicResource WindowGradient}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="WindowTitleBar" Grid.Row="0" Title="Ear Saxophone">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Kopfzeile: Verbindung links; Profil, Neu verbinden, MIDI-Learn und Zahnrad rechts -->
        <Grid x:Name="HeaderBar" Grid.Row="1" Margin="12,0,12,6" Height="34">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border x:Name="ConnectionStatus" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Height="32"
                    CornerRadius="16" Padding="12,0,14,0" Background="{DynamicResource SubtleFillBrush}"
                    BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1" Margin="0,0,12,0"
                    ToolTip="{Binding ConnectionText}" AutomationProperties.AutomationId="ConnectionStatus">
                <DockPanel VerticalAlignment="Center">
                    <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Margin="0,0,9,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#E0605A" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="#4CC38A" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock x:Name="ConnectionTextBlock" Text="{Binding ConnectionText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               AutomationProperties.AutomationId="ConnectionText" />
                </DockPanel>
            </Border>

            <!-- Profil: kleines Auswahlfeld, Verwalten im Menü -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                <ui:SymbolIcon Symbol="Person20" FontSize="16" Margin="0,0,8,0" Foreground="{DynamicResource MutedText}" VerticalAlignment="Center" />
                <ComboBox x:Name="ProfilePicker" Width="132" Height="32" MinHeight="0" Padding="10,4" VerticalContentAlignment="Center"
                          ItemsSource="{Binding ProfileNames}" SelectedItem="{Binding ActiveProfileName, Mode=TwoWay}"
                          ToolTip="{x:Static loc:Texts.UiProfile}" AutomationProperties.AutomationId="ProfilePicker"
                          AutomationProperties.Name="{x:Static loc:Texts.UiProfile}" />
                <ToggleButton x:Name="ProfileMenuButton" Style="{StaticResource IconButton}" Margin="4,0,0,0"
                              ToolTip="{x:Static loc:Texts.UiProfileMenu}" AutomationProperties.AutomationId="ProfileMenuButton"
                              AutomationProperties.Name="{x:Static loc:Texts.UiProfileMenu}"
                              IsHitTestVisible="{Binding IsOpen, ElementName=ProfilePopup, Converter={StaticResource Inverse}}">
                    <ui:SymbolIcon Symbol="MoreHorizontal20" />
                </ToggleButton>
                <Popup x:Name="ProfilePopup" PlacementTarget="{Binding ElementName=ProfileMenuButton}" Placement="Bottom"
                       HorizontalOffset="-150" VerticalOffset="2" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                       IsOpen="{Binding IsChecked, ElementName=ProfileMenuButton, Mode=TwoWay}">
                    <Border Style="{StaticResource PopupCard}" Width="290">
                        <StackPanel>
                            <TextBlock Text="{x:Static loc:Texts.UiProfileRename}" Style="{StaticResource SectionLabel}" Margin="2,0,0,6" />
                            <ui:TextBox x:Name="ProfileNameBox" Text="{Binding ProfileNameEdit, UpdateSourceTrigger=LostFocus}"
                                        Icon="{ui:SymbolIcon Rename20}" ToolTip="{x:Static loc:Texts.UiProfileRenameTip}"
                                        KeyDown="ProfileNameBox_KeyDown" AutomationProperties.AutomationId="ProfileNameBox"
                                        AutomationProperties.Name="{x:Static loc:Texts.UiProfileRename}" />
                            <Separator Margin="0,14,0,10" Opacity="0.4" />
                            <ui:Button x:Name="NewProfileButton" Content="{x:Static loc:Texts.UiNewProfile}" Icon="{ui:SymbolIcon Add20}"
                                       HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding NewProfileCommand}"
                                       AutomationProperties.AutomationId="NewProfileButton" />
                            <ui:Button x:Name="DeleteProfileButton" Content="{x:Static loc:Texts.UiDeleteProfile}" Icon="{ui:SymbolIcon Delete20}"
                                       Margin="0,6,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                       Command="{Binding DeleteProfileCommand}" AutomationProperties.AutomationId="DeleteProfileButton" />
                        </StackPanel>
                    </Border>
                </Popup>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button x:Name="ReconnectButton" Icon="{ui:SymbolIcon PlugConnected20}" Width="38" Height="32" AutomationProperties.Name="{x:Static loc:Texts.UiReconnect}"
                           Command="{Binding ReconnectCommand}" ToolTip="{x:Static loc:Texts.UiReconnectTip}"
                           AutomationProperties.AutomationId="ReconnectButton" />
                <ui:Button x:Name="LearnButton" Icon="{ui:SymbolIcon TapSingle20}" Width="38" Height="32" Margin="6,0,0,0" AutomationProperties.Name="{x:Static loc:Texts.UiLearn}"
                           Command="{Binding LearnCommand}" ToolTip="{x:Static loc:Texts.UiLearnTip}"
                           Visibility="{Binding IsLearning, Converter={StaticResource InverseBoolToVis}}"
                           AutomationProperties.AutomationId="LearnButton" />
                <ui:Button x:Name="CancelLearnButton" Icon="{ui:SymbolIcon Dismiss20}" Width="38" Height="32" Margin="6,0,0,0" AutomationProperties.Name="{x:Static loc:Texts.UiCancel}" ToolTip="{x:Static loc:Texts.UiCancel}"
                           Appearance="Primary" Command="{Binding CancelLearnCommand}"
                           Visibility="{Binding IsLearning, Converter={StaticResource BoolToVis}}"
                           AutomationProperties.AutomationId="CancelLearnButton" />
            </StackPanel>

            <!-- Zahnrad: alle Einstellungen -->
            <Grid Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center">
                <ToggleButton x:Name="SettingsButton" Style="{StaticResource IconButton}" ToolTip="{x:Static loc:Texts.UiSettings}"
                              AutomationProperties.AutomationId="SettingsButton" AutomationProperties.Name="{x:Static loc:Texts.UiSettings}"
                              IsHitTestVisible="{Binding IsOpen, ElementName=SettingsPopup, Converter={StaticResource Inverse}}">
                    <ui:SymbolIcon Symbol="Settings20" FontSize="18" />
                </ToggleButton>
                <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsButton}" Placement="Bottom"
                       HorizontalOffset="-330" VerticalOffset="2" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                       IsOpen="{Binding IsChecked, ElementName=SettingsButton, Mode=TwoWay}">
                    <Border x:Name="SettingsPanel" Style="{StaticResource PopupCard}" Width="344">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <ui:SymbolIcon Symbol="Settings20" FontSize="18" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0" />
                                <TextBlock Text="{x:Static loc:Texts.UiSettings}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Text="{x:Static loc:Texts.UiStyle}" Style="{StaticResource SectionLabel}" Margin="2,12,0,6" />
                            <ComboBox x:Name="StylePicker" ItemsSource="{Binding StyleOptions}" DisplayMemberPath="Text" SelectedValuePath="Value"
                                      SelectedValue="{Binding Style, Mode=TwoWay}" HorizontalAlignment="Stretch" Height="32" MinHeight="0"
                                      AutomationProperties.AutomationId="StylePicker" AutomationProperties.Name="{x:Static loc:Texts.UiStyle}" />
                            <Separator Margin="0,10,0,0" Opacity="0.4" />
                            <ui:ToggleSwitch x:Name="ShowOsdToggle" Content="{x:Static loc:Texts.UiOsdToggle}" IsChecked="{Binding ShowOsd, Mode=TwoWay}"
                                             Margin="0,12,0,0" AutomationProperties.AutomationId="ShowOsdToggle" />
                            <TextBlock Text="{x:Static loc:Texts.UiOsdPosition}" Style="{StaticResource SectionLabel}" Margin="2,12,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ListBox x:Name="OsdPositionPicker" Style="{StaticResource TileList}" ItemContainerStyle="{StaticResource PositionTileItem}"
                                         ItemsSource="{Binding OsdPositionOptions}" SelectedValuePath="Value"
                                         SelectedValue="{Binding OsdPosition, Mode=TwoWay}" Width="150" HorizontalAlignment="Left"
                                         AutomationProperties.AutomationId="OsdPositionPicker" AutomationProperties.Name="{x:Static loc:Texts.UiOsdPosition}">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3" Rows="2" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                </ListBox>
                                <ui:Button x:Name="TestOsdButton" Grid.Column="1" Content="{x:Static loc:Texts.UiOsdTest}" Icon="{ui:SymbolIcon Eye20}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding TestOsdCommand}"
                                           AutomationProperties.AutomationId="TestOsdButton" />
                            </Grid>

                            <Separator Margin="0,10,0,6" Opacity="0.4" />
                            <ui:ToggleSwitch x:Name="StartWithWindowsToggle" Content="{x:Static loc:Texts.UiStartWithWindows}"
                                             IsChecked="{Binding StartWithWindows, Mode=TwoWay}" Margin="0,6,0,0"
                                             AutomationProperties.AutomationId="StartWithWindowsToggle" />
                            <ui:ToggleSwitch x:Name="KeepInTrayToggle" Content="{x:Static loc:Texts.UiKeepInTray}"
                                             IsChecked="{Binding KeepInTray, Mode=TwoWay}" Margin="0,10,0,0"
                                             AutomationProperties.AutomationId="KeepInTrayToggle" />
                            <ui:ToggleSwitch x:Name="StartMinimizedToggle" Content="{x:Static loc:Texts.UiStartMinimized}"
                                             IsChecked="{Binding StartMinimized, Mode=TwoWay}" Margin="0,10,0,0"
                                             AutomationProperties.AutomationId="StartMinimizedToggle" />
                            <ui:ToggleSwitch x:Name="LedFeedbackToggle" Content="{x:Static loc:Texts.UiLedFeedback}" ToolTip="{x:Static loc:Texts.UiLedFeedbackTip}"
                                             IsChecked="{Binding LedFeedback, Mode=TwoWay}" Margin="0,10,0,0"
                                             AutomationProperties.AutomationId="LedFeedbackToggle" />
                            <ui:ToggleSwitch x:Name="LedBlinkToggle" Content="{x:Static loc:Texts.UiLedBlink}" ToolTip="{x:Static loc:Texts.UiLedBlinkTip}"
                                             IsChecked="{Binding LedBlink, Mode=TwoWay}" Margin="0,10,0,0"
                                             AutomationProperties.AutomationId="LedBlinkToggle" />

                            <Separator Margin="0,14,0,6" Opacity="0.4" />
                            <ui:ToggleSwitch x:Name="AskForNewProgramsToggle" Content="{x:Static loc:Texts.UiAskForNewPrograms}"
                                             IsChecked="{Binding AskForNewPrograms, Mode=TwoWay}" Margin="0,6,0,0"
                                             AutomationProperties.AutomationId="AskForNewProgramsToggle" />
                            <ui:ToggleSwitch x:Name="PromptSoundToggle" Content="{x:Static loc:Texts.UiPromptSound}"
                                             IsChecked="{Binding PromptSound, Mode=TwoWay}" Margin="0,6,0,0"
                                             AutomationProperties.AutomationId="PromptSoundToggle" />
                            <ui:Button x:Name="ResetIgnoredButton" Content="{x:Static loc:Texts.UiResetIgnoredPrograms}" Icon="{ui:SymbolIcon ArrowReset20}"
                                       Margin="0,10,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                       Command="{Binding ResetIgnoredProgramsCommand}" IsEnabled="{Binding HasIgnoredPrograms}"
                                       AutomationProperties.AutomationId="ResetIgnoredButton" />

                            <!-- Updates: Version, Suche, Installation, automatische Prüfung -->
                            <Separator Margin="0,14,0,6" Opacity="0.4" />
                            <StackPanel x:Name="UpdateSection" AutomationProperties.AutomationId="UpdateSection">
                                <TextBlock Text="{x:Static loc:Texts.UiUpdates}" Style="{StaticResource SectionLabel}" Margin="2,6,0,4" />
                                <TextBlock x:Name="UpdateInstalledText" Text="{Binding Update.InstalledVersionText}" Style="{StaticResource Hint}" Margin="2,0,0,0"
                                           AutomationProperties.AutomationId="UpdateInstalledText" />
                                <TextBlock x:Name="UpdateStatusText" Text="{Binding Update.StatusText}" TextWrapping="Wrap" Margin="2,6,0,0"
                                           Visibility="{Binding Update.HasStatusText, Converter={StaticResource BoolToVis}}"
                                           AutomationProperties.AutomationId="UpdateStatusText" />
                                <ui:Button x:Name="CheckForUpdatesButton" Content="{x:Static loc:Texts.UiCheckForUpdates}" Icon="{ui:SymbolIcon ArrowSync20}"
                                           Margin="0,10,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                           Command="{Binding Update.CheckCommand}" AutomationProperties.AutomationId="CheckForUpdatesButton" />
                                <ui:Button x:Name="GearInstallUpdateButton" Content="{x:Static loc:Texts.UiInstallUpdate}" Icon="{ui:SymbolIcon ArrowDownload20}"
                                           Appearance="Primary" Margin="0,6,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                           Command="{Binding Update.InstallCommand}" ToolTip="{x:Static loc:Texts.UiInstallUpdateTip}"
                                           Visibility="{Binding Update.IsUpdateAvailable, Converter={StaticResource BoolToVis}}"
                                           AutomationProperties.AutomationId="GearInstallUpdateButton" />
                                <ui:ToggleSwitch x:Name="CheckUpdatesOnStartToggle" Content="{x:Static loc:Texts.UiCheckForUpdatesOnStart}"
                                                 IsChecked="{Binding Update.CheckOnStart, Mode=TwoWay}" Margin="0,10,0,0"
                                                 AutomationProperties.AutomationId="CheckUpdatesOnStartToggle" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Grid>

        <!-- Hauptbereich: Gerätebild links, Seitenpanel rechts -->
        <Grid Grid.Row="2" Margin="12,0,12,2">
            

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <!-- Neue Version verfügbar (oder Update läuft): dezenter Hinweis mit "Jetzt aktualisieren" und Fortschritt -->
                    <Border x:Name="UpdateBanner" Visibility="{Binding Update.ShowBanner, Converter={StaticResource BoolToVis}}" Padding="14,6,6,6"
                            Margin="0,0,0,8" CornerRadius="{DynamicResource PopupRadius}" Background="{DynamicResource SubtleFillBrush}" BorderBrush="{DynamicResource CardStrokeBrush}"
                            BorderThickness="1" AutomationProperties.AutomationId="UpdateBanner">
                        <DockPanel>
                            <ui:SymbolIcon DockPanel.Dock="Left" Symbol="ArrowCircleUp20" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentStrongBrush}" />
                            <Button x:Name="DismissUpdateButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Margin="4,0,0,0"
                                    Command="{Binding Update.DismissCommand}" ToolTip="{x:Static loc:Texts.UiDismissUpdate}"
                                    Visibility="{Binding Update.IsInstalling, Converter={StaticResource InverseBoolToVis}}"
                                    AutomationProperties.AutomationId="DismissUpdateButton" AutomationProperties.Name="{x:Static loc:Texts.UiDismissUpdate}">
                                <ui:SymbolIcon Symbol="Dismiss20" />
                            </Button>
                            <ui:Button x:Name="InstallUpdateButton" DockPanel.Dock="Right" Content="{x:Static loc:Texts.UiInstallUpdate}"
                                       Icon="{ui:SymbolIcon ArrowDownload20}" Appearance="Primary" Height="30" Command="{Binding Update.InstallCommand}"
                                       ToolTip="{x:Static loc:Texts.UiInstallUpdateTip}"
                                       Visibility="{Binding Update.IsInstalling, Converter={StaticResource InverseBoolToVis}}"
                                       AutomationProperties.AutomationId="InstallUpdateButton" />
                            <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock x:Name="UpdateBannerText" Text="{Binding Update.BannerText}" TextTrimming="CharacterEllipsis"
                                           AutomationProperties.AutomationId="UpdateBannerText" />
                                <ProgressBar x:Name="UpdateProgress" Minimum="0" Maximum="1" Value="{Binding Update.Progress, Mode=OneWay}" Height="4"
                                             Margin="0,6,0,2" Visibility="{Binding Update.IsInstalling, Converter={StaticResource BoolToVis}}"
                                             AutomationProperties.AutomationId="UpdateProgress" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- MIDI-Learn läuft -->
                    <Border x:Name="LearnBanner" Visibility="{Binding IsLearning, Converter={StaticResource BoolToVis}}" Padding="14,10"
                            Margin="0,0,0,8" CornerRadius="{DynamicResource PopupRadius}" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1" AutomationProperties.AutomationId="LearnBanner">
                        <DockPanel>
                            <ui:SymbolIcon DockPanel.Dock="Left" Symbol="TapSingle20" FontSize="18" Margin="0,0,10,0" Foreground="{DynamicResource AccentStrongBrush}" />
                            <TextBlock x:Name="LearnHintText" Text="{Binding LearnHint}" TextWrapping="Wrap" VerticalAlignment="Center"
                                       AutomationProperties.AutomationId="LearnHint" />
                        </DockPanel>
                    </Border>

                    <!-- Am Gerät wurde ein anderes Element bedient, während die Bearbeitung offen ist -->
                    <Border x:Name="PendingBanner" Visibility="{Binding HasPendingSelection, Converter={StaticResource BoolToVis}}" Padding="14,6,8,6"
                            Margin="0,0,0,8" CornerRadius="{DynamicResource PopupRadius}" Background="{DynamicResource SubtleFillBrush}" BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1" AutomationProperties.AutomationId="PendingBanner">
                        <DockPanel>
                            <ui:SymbolIcon DockPanel.Dock="Left" Symbol="CursorClick20" FontSize="18" Margin="0,0,10,0" Foreground="{DynamicResource AccentStrongBrush}" />
                            <ui:Button x:Name="SelectPendingButton" DockPanel.Dock="Right" Content="{x:Static loc:Texts.UiSelectPending}"
                                       Icon="{ui:SymbolIcon ArrowEnter20}" Command="{Binding SelectPendingCommand}" Height="30"
                                       AutomationProperties.AutomationId="SelectPendingButton" />
                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                <Run Text="{x:Static loc:Texts.UiPendingHint}" Foreground="{DynamicResource MutedText}" />
                                <Run Text="{Binding PendingElement.Label, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- Das Gerät als Bild -->
                <Viewbox x:Name="DeviceView" Grid.Row="1" Stretch="Uniform" Margin="0" AutomationProperties.AutomationId="DeviceView" ToolTip="{x:Static loc:Texts.UiDragHint}" ToolTipService.InitialShowDelay="1200">
                    <Grid Width="1000" Height="270" Margin="8,4,8,12">
                        <!-- Gehäuse: flach und schwarz wie das echte Gerät -->
                        <Border CornerRadius="{DynamicResource BodyRadius}" Background="{DynamicResource BodyBrush}" BorderBrush="{DynamicResource DeviceEdge}" BorderThickness="1.5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="36" ShadowDepth="10" Opacity="0.6" Color="Black" />
                            </Border.Effect>
                        </Border>
                        <Border CornerRadius="13,13,0,0" Margin="1.5" Height="2" VerticalAlignment="Top" Background="#14FFFFFF" IsHitTestVisible="False" />
                        <!-- Aufdrucke auf dem Gehäuse (Lage passend zu Nanokontrol2Layout) -->
                        <Canvas IsHitTestVisible="False">
                            <Ellipse Canvas.Left="30" Canvas.Top="22" Width="9" Height="9" Fill="#BFE9FF" />
                            <TextBlock Canvas.Left="30" Canvas.Top="44" Text="nanoKONTROL2" FontSize="28" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrintBrush}" />
                            <TextBlock Canvas.Left="33" Canvas.Top="86" Width="88" TextAlignment="Center" Text="TRACK" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrintBrush}" />
                            <TextBlock Canvas.Left="129" Canvas.Top="129" Width="139" TextAlignment="Center" Text="MARKER" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrintBrush}" />
                            <Rectangle Canvas.Left="129" Canvas.Top="136" Width="38" Height="1" Fill="#66FFFFFF" />
                            <Rectangle Canvas.Left="230" Canvas.Top="136" Width="38" Height="1" Fill="#66FFFFFF" />
                        </Canvas>
                        <ItemsControl x:Name="DeviceElements" ItemsSource="{Binding Elements}" ItemTemplateSelector="{StaticResource ElementSelector}"
                                      Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>
                    </Grid>
                </Viewbox>

                <!-- Weitere Regler (per MIDI-Learn gefunden) -->
                <StackPanel x:Name="ExtraPanel" Grid.Row="2" Visibility="{Binding HasExtraElements, Converter={StaticResource BoolToVis}}" Margin="4,0,4,4">
                    <TextBlock Text="{x:Static loc:Texts.UiExtraControls}" Style="{StaticResource SectionLabel}" Margin="2,0,0,6" />
                    <ItemsControl x:Name="ExtraElementList" ItemsSource="{Binding ExtraElements}" ItemTemplate="{StaticResource ExtraTemplate}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Margin="4,4,0,0" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="6,0,0,0" Visibility="Collapsed">
                    <ui:SymbolIcon Symbol="HandDraw20" FontSize="13" Foreground="{DynamicResource MutedText}" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Static loc:Texts.UiDragHint}" Style="{StaticResource Hint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Statuszeile und Fehlerleiste (nur wenn nötig) -->
        <StackPanel Grid.Row="3" Margin="12,0,12,6">
            <Border x:Name="ErrorBar" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" CornerRadius="{DynamicResource ControlRadius}" Padding="12,6,6,6" Margin="0,0,0,6"
                    Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}" AutomationProperties.AutomationId="ErrorBar">
                <DockPanel>
                    <ui:SymbolIcon DockPanel.Dock="Left" Symbol="ErrorCircle20" FontSize="18" Foreground="{DynamicResource DangerBrush}" Margin="0,0,10,0"
                                   VerticalAlignment="Center" />
                    <Button x:Name="DismissErrorButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding DismissErrorCommand}"
                            ToolTip="{x:Static loc:Texts.UiClose}" AutomationProperties.AutomationId="DismissErrorButton"
                            AutomationProperties.Name="{x:Static loc:Texts.UiClose}">
                        <ui:SymbolIcon Symbol="Dismiss20" />
                    </Button>
                    <TextBlock x:Name="ErrorText" Text="{Binding ErrorMessage}" TextWrapping="Wrap" VerticalAlignment="Center"
                               AutomationProperties.AutomationId="ErrorText" />
                </DockPanel>
            </Border>
            <TextBlock x:Name="StatusText" Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" FontSize="12" Margin="4,0,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" ToolTip="{Binding StatusMessage}"
                       AutomationProperties.AutomationId="StatusText" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
