<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Stil "Papier" (erzeugt; alle Schlüssel müssen in jeder Stil-Datei stehen) -->
    <Color x:Key="AccentColor">#E2552D</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#E2552D" />
    <SolidColorBrush x:Key="AccentStrongBrush" Color="#B93E1B" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2EE2552D" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBrush" Color="#F8F4EA" />
    <SolidColorBrush x:Key="PopupBrush" Color="#FFFBF2" />
    <SolidColorBrush x:Key="CardStrokeBrush" Color="#CFC5B2" />
    <SolidColorBrush x:Key="SubtleFillBrush" Color="#0F2A2622" />
    <SolidColorBrush x:Key="SubtleHoverBrush" Color="#1E2A2622" />
    <SolidColorBrush x:Key="MutedText" Color="#7B7266" />
    <SolidColorBrush x:Key="DangerBrush" Color="#B3261E" />
    <SolidColorBrush x:Key="InkBrush" Color="#2A2622" />
    <SolidColorBrush x:Key="InkSecondaryBrush" Color="#5E564B" />
    <SolidColorBrush x:Key="AppBackdropBrush" Color="#EFE9DC" />
    <LinearGradientBrush x:Key="WindowGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#EFE9DC" Offset="0" />
            <GradientStop Color="#EAE3D3" Offset="0.5" />
            <GradientStop Color="#E2DAC8" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BodyBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#EFEADD" Offset="0" />
            <GradientStop Color="#E6E0D0" Offset="0.5" />
            <GradientStop Color="#DAD3C0" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="DeviceEdge" Color="#A59B86" />
    <SolidColorBrush x:Key="PrintBrush" Color="#2A2622" />
    <SolidColorBrush x:Key="PrintSoftBrush" Color="#6B6355" />
    <SolidColorBrush x:Key="KeyGlyphBrush" Color="#2A2622" />
    <LinearGradientBrush x:Key="KeyBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FBF8F0" Offset="0" />
            <GradientStop Color="#E3DDCD" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="KeyActiveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0" />
            <GradientStop Color="#F2EEE2" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="KeyEdgeBrush" Color="#9A907B" />
    <SolidColorBrush x:Key="LedOffBrush" Color="#D9A798" />
    <SolidColorBrush x:Key="LedOnBrush" Color="#E2552D" />
    <SolidColorBrush x:Key="KnobMarkBrush" Color="#2A2622" />
    <RadialGradientBrush x:Key="KnobBrush" GradientOrigin="0.38,0.3" Center="0.5,0.5" RadiusX="0.65" RadiusY="0.65">
            <GradientStop Color="#FAF7F0" Offset="0" />
            <GradientStop Color="#D9D2C1" Offset="0.6" />
            <GradientStop Color="#B9B19D" Offset="1" />
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="FaderCapBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0" />
            <GradientStop Color="#E4DECE" Offset="0.5" />
            <GradientStop Color="#BDB5A0" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SlotBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#4A443A" Offset="0" />
            <GradientStop Color="#2A2622" Offset="0.5" />
            <GradientStop Color="#4A443A" Offset="1" />
    </LinearGradientBrush>
    <CornerRadius x:Key="CardRadius">3</CornerRadius>
    <CornerRadius x:Key="PopupRadius">3</CornerRadius>
    <CornerRadius x:Key="ControlRadius">2</CornerRadius>
    <CornerRadius x:Key="KeyRadius">2</CornerRadius>
    <CornerRadius x:Key="BodyRadius">4</CornerRadius>
    <FontFamily x:Key="UiFont">Cascadia Mono, Consolas, Courier New</FontFamily>
    <!-- Überschreibt die Systemfarben von WPF-UI, damit Texte zum Stil passen -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#2A2622" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#5E564B" />
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#EFE9DC" />
</ResourceDictionary>
