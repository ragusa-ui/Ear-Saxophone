<Window x:Class="EarSaxophone.App.ProgramPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ear Saxophone Nachfrage"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" Focusable="False"
        ResizeMode="NoResize" SizeToContent="Manual" Width="484" Height="324">
    <Window.Resources>

        <!-- Round knob (stepless control, shown as a small circle). -->
        <Style x:Key="KnobButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Disc" Fill="#3A4160" Stroke="#566086" StrokeThickness="1" />
                            <Rectangle Width="2" Height="8" RadiusX="1" RadiusY="1" Fill="#C9CFE2"
                                       VerticalAlignment="Top" Margin="0,3,0,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Disc" Property="Fill" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Disc" Property="Stroke" Value="#7FE6D9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Taken by another mapping: dimmed, but still clickable. -->
                <DataTrigger Binding="{Binding HasMapping}" Value="True">
                    <Setter Property="Opacity" Value="0.42" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Narrow fader rail with a small cap; the whole column is the click target. -->
        <Style x:Key="FaderButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="62" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="Rail" Width="6" CornerRadius="3" Background="{DynamicResource CardStrokeBrush}" />
                            <Border x:Name="Cap" Width="16" Height="9" CornerRadius="3" Background="#C9CFE2"
                                    VerticalAlignment="Bottom" Margin="0,0,0,12" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Rail" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Cap" Property="Background" Value="#7FE6D9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Taken by another mapping: dimmed, but still clickable. -->
                <DataTrigger Binding="{Binding HasMapping}" Value="True">
                    <Setter Property="Opacity" Value="0.42" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="6" Padding="8,3" Background="Transparent">
                            <TextBlock Text="{TemplateBinding Content}" FontSize="12" Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2B3146" />
                                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer border carries the teal glow (pulses for the first seconds, see code-behind); the card slides in. -->
    <Border x:Name="Card" Margin="12" CornerRadius="16" Background="{DynamicResource PopupBrush}"
            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" Opacity="0"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" X="36" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect x:Name="Glow" BlurRadius="18" ShadowDepth="0" Opacity="0.55" Color="#3FB6A8" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header band: "Neues Programm mit Ton". -->
            <Border Grid.Row="0" CornerRadius="14.5,14.5,0,0" Background="{DynamicResource AccentBrush}" Padding="16,6,16,6">
                <StackPanel Orientation="Horizontal">
                    <!-- Small speaker with sound waves. -->
                    <Path Width="16" Height="14" Stretch="Uniform" Fill="{DynamicResource OnAccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"
                          Data="M0,5 L4,5 L9,0 L9,16 L4,11 L0,11 Z M11,4 C13,6 13,10 11,12 L12,13 C15,10 15,6 12,3 Z M13,1 C17,5 17,11 13,15 L14,16 C19,11 19,5 14,0 Z" />
                    <TextBlock Text="{Binding Header}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource OnAccentBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Program icon, name and question. -->
            <Grid Grid.Row="1" Margin="18,12,18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="44" Height="44" CornerRadius="10" Background="#262B3D" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Grid>
                        <TextBlock x:Name="IconFallback" Text="{Binding ProgramInitial}" FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image x:Name="ProgramIcon" Width="32" Height="32" Visibility="Collapsed"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProgramName}" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource InkBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Question}" Margin="0,1,0,0" FontSize="13.5"
                               Foreground="{DynamicResource InkSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <ItemsControl Grid.Row="2" ItemsSource="{Binding Slots}" Focusable="False" Margin="22,10,22,0"
                          VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Columns="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <Button Style="{StaticResource KnobButton}" Margin="0,0,0,6"
                                    DataContext="{Binding Knob}"
                                    ToolTip="{Binding TooltipText}"
                                    Command="{Binding DataContext.AssignCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                            <Button Style="{StaticResource FaderButton}"
                                    DataContext="{Binding Fader}"
                                    ToolTip="{Binding TooltipText}"
                                    Command="{Binding DataContext.AssignCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                            <TextBlock Text="{Binding Number}" HorizontalAlignment="Center" Margin="0,4,0,0"
                                       FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedText}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,12,6">
                <Button Style="{StaticResource LinkButton}" Content="{Binding NotNowText}" Command="{Binding NotNowCommand}" />
                <Button Style="{StaticResource LinkButton}" Content="{Binding NeverAskText}" Command="{Binding NeverAskCommand}" />
            </StackPanel>

            <!-- Countdown until the question closes itself as "Nicht jetzt" (shrinks to the left, see code-behind). -->
            <Border Grid.Row="4" Height="4" Margin="14,0,14,8" CornerRadius="2" Background="#262B3D"
                    ToolTip="{Binding AutoCloseHint}">
                <Border x:Name="CountdownBar" CornerRadius="2" Background="{DynamicResource AccentBrush}"
                        RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="CountdownScale" ScaleX="1" />
                    </Border.RenderTransform>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
