<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Stil "Messing" (erzeugt; alle Schlüssel müssen in jeder Stil-Datei stehen) -->
    <Color x:Key="AccentColor">#D6A94A</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#D6A94A" />
    <SolidColorBrush x:Key="AccentStrongBrush" Color="#EBC878" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2ED6A94A" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#2B1D14" />
    <SolidColorBrush x:Key="CardBrush" Color="#E63A281B" />
    <SolidColorBrush x:Key="PopupBrush" Color="#FA3A281B" />
    <SolidColorBrush x:Key="CardStrokeBrush" Color="#5A4128" />
    <SolidColorBrush x:Key="SubtleFillBrush" Color="#12F1E3C8" />
    <SolidColorBrush x:Key="SubtleHoverBrush" Color="#26F1E3C8" />
    <SolidColorBrush x:Key="MutedText" Color="#B59B72" />
    <SolidColorBrush x:Key="DangerBrush" Color="#E57B5A" />
    <SolidColorBrush x:Key="InkBrush" Color="#F1E3C8" />
    <SolidColorBrush x:Key="InkSecondaryBrush" Color="#CDB892" />
    <SolidColorBrush x:Key="AppBackdropBrush" Color="#2B1D14" />
    <LinearGradientBrush x:Key="WindowGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#35241A" Offset="0" />
            <GradientStop Color="#2B1D14" Offset="0.5" />
            <GradientStop Color="#1B110B" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BodyBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#6B4426" Offset="0" />
            <GradientStop Color="#4A2E18" Offset="0.5" />
            <GradientStop Color="#33200F" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="DeviceEdge" Color="#8A6A3A" />
    <SolidColorBrush x:Key="PrintBrush" Color="#F1E3C8" />
    <SolidColorBrush x:Key="PrintSoftBrush" Color="#C9B48C" />
    <SolidColorBrush x:Key="KeyGlyphBrush" Color="#2B1D14" />
    <LinearGradientBrush x:Key="KeyBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#EBCB7A" Offset="0" />
            <GradientStop Color="#A98230" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="KeyActiveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F7DE9A" Offset="0" />
            <GradientStop Color="#C79A3C" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="KeyEdgeBrush" Color="#3A280F" />
    <SolidColorBrush x:Key="LedOffBrush" Color="#8A5A2A" />
    <SolidColorBrush x:Key="LedOnBrush" Color="#FF5A3A" />
    <SolidColorBrush x:Key="KnobMarkBrush" Color="#2B1D14" />
    <RadialGradientBrush x:Key="KnobBrush" GradientOrigin="0.38,0.3" Center="0.5,0.5" RadiusX="0.65" RadiusY="0.65">
            <GradientStop Color="#EBC878" Offset="0" />
            <GradientStop Color="#A8832F" Offset="0.6" />
            <GradientStop Color="#6B5018" Offset="1" />
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="FaderCapBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#EBC878" Offset="0" />
            <GradientStop Color="#B8913A" Offset="0.5" />
            <GradientStop Color="#7A5A1E" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SlotBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#150D07" Offset="0" />
            <GradientStop Color="#241609" Offset="0.5" />
            <GradientStop Color="#150D07" Offset="1" />
    </LinearGradientBrush>
    <CornerRadius x:Key="CardRadius">6</CornerRadius>
    <CornerRadius x:Key="PopupRadius">6</CornerRadius>
    <CornerRadius x:Key="ControlRadius">4</CornerRadius>
    <CornerRadius x:Key="KeyRadius">4</CornerRadius>
    <CornerRadius x:Key="BodyRadius">10</CornerRadius>
    <FontFamily x:Key="UiFont">Georgia, Cambria, Times New Roman</FontFamily>
    <!-- Überschreibt die Systemfarben von WPF-UI, damit Texte zum Stil passen -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#F1E3C8" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#CDB892" />
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#2B1D14" />
</ResourceDictionary>
