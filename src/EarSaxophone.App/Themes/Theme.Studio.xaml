<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Stil "Studio" (erzeugt; alle Schlüssel müssen in jeder Stil-Datei stehen) -->
    <Color x:Key="AccentColor">#3FB6A8</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#3FB6A8" />
    <SolidColorBrush x:Key="AccentStrongBrush" Color="#7FE6D9" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2E3FB6A8" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#0E1A1A" />
    <SolidColorBrush x:Key="CardBrush" Color="#D91B1F2C" />
    <SolidColorBrush x:Key="PopupBrush" Color="#FA1D2130" />
    <SolidColorBrush x:Key="CardStrokeBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="SubtleFillBrush" Color="#10FFFFFF" />
    <SolidColorBrush x:Key="SubtleHoverBrush" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="MutedText" Color="#8D96AE" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF7B72" />
    <SolidColorBrush x:Key="InkBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InkSecondaryBrush" Color="#C5CAD8" />
    <SolidColorBrush x:Key="AppBackdropBrush" Color="#12141C" />
    <LinearGradientBrush x:Key="WindowGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1C2130" Offset="0" />
            <GradientStop Color="#12141C" Offset="0.5" />
            <GradientStop Color="#0F1A1C" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BodyBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2A2B2F" Offset="0" />
            <GradientStop Color="#1E1F22" Offset="0.5" />
            <GradientStop Color="#17181A" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="DeviceEdge" Color="#44464C" />
    <SolidColorBrush x:Key="PrintBrush" Color="#F2F2F2" />
    <SolidColorBrush x:Key="PrintSoftBrush" Color="#A9ACB3" />
    <SolidColorBrush x:Key="KeyGlyphBrush" Color="#F2F2F2" />
    <LinearGradientBrush x:Key="KeyBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2A2B2F" Offset="0" />
            <GradientStop Color="#16171A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="KeyActiveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#5C5F67" Offset="0" />
            <GradientStop Color="#45484F" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="KeyEdgeBrush" Color="#08090A" />
    <SolidColorBrush x:Key="LedOffBrush" Color="#6B3636" />
    <SolidColorBrush x:Key="LedOnBrush" Color="#FF5A4A" />
    <SolidColorBrush x:Key="KnobMarkBrush" Color="#F2F2F2" />
    <RadialGradientBrush x:Key="KnobBrush" GradientOrigin="0.38,0.3" Center="0.5,0.5" RadiusX="0.65" RadiusY="0.65">
            <GradientStop Color="#4A4C52" Offset="0" />
            <GradientStop Color="#232428" Offset="0.6" />
            <GradientStop Color="#121214" Offset="1" />
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="FaderCapBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#3C3E44" Offset="0" />
            <GradientStop Color="#1C1D20" Offset="0.5" />
            <GradientStop Color="#0E0E10" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SlotBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#8A8C92" Offset="0" />
            <GradientStop Color="#BDBFC4" Offset="0.5" />
            <GradientStop Color="#8A8C92" Offset="1" />
    </LinearGradientBrush>
    <CornerRadius x:Key="CardRadius">16</CornerRadius>
    <CornerRadius x:Key="PopupRadius">14</CornerRadius>
    <CornerRadius x:Key="ControlRadius">8</CornerRadius>
    <CornerRadius x:Key="KeyRadius">6</CornerRadius>
    <CornerRadius x:Key="BodyRadius">14</CornerRadius>
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <!-- Überschreibt die Systemfarben von WPF-UI, damit Texte zum Stil passen -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#C5CAD8" />
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#12141C" />
</ResourceDictionary>
