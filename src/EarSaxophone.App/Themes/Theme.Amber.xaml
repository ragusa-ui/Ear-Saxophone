<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Stil "Amber" (erzeugt; alle Schlüssel müssen in jeder Stil-Datei stehen) -->
    <Color x:Key="AccentColor">#FFB347</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#FFB347" />
    <SolidColorBrush x:Key="AccentStrongBrush" Color="#FFD08A" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2EFFB347" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#1A120A" />
    <SolidColorBrush x:Key="CardBrush" Color="#E6241909" />
    <SolidColorBrush x:Key="PopupBrush" Color="#FA2A1D0E" />
    <SolidColorBrush x:Key="CardStrokeBrush" Color="#4A3412" />
    <SolidColorBrush x:Key="SubtleFillBrush" Color="#12FFB347" />
    <SolidColorBrush x:Key="SubtleHoverBrush" Color="#26FFB347" />
    <SolidColorBrush x:Key="MutedText" Color="#A8742C" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF6A3D" />
    <SolidColorBrush x:Key="InkBrush" Color="#FFB347" />
    <SolidColorBrush x:Key="InkSecondaryBrush" Color="#C98A33" />
    <SolidColorBrush x:Key="AppBackdropBrush" Color="#1A120A" />
    <LinearGradientBrush x:Key="WindowGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1F1509" Offset="0" />
            <GradientStop Color="#1A120A" Offset="0.5" />
            <GradientStop Color="#0E0904" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BodyBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2A1D10" Offset="0" />
            <GradientStop Color="#1D1409" Offset="0.5" />
            <GradientStop Color="#150E06" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="DeviceEdge" Color="#6B4A1A" />
    <SolidColorBrush x:Key="PrintBrush" Color="#FFB347" />
    <SolidColorBrush x:Key="PrintSoftBrush" Color="#A8742C" />
    <SolidColorBrush x:Key="KeyGlyphBrush" Color="#FFB347" />
    <LinearGradientBrush x:Key="KeyBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#3A2814" Offset="0" />
            <GradientStop Color="#1E1409" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="KeyActiveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#6B4A1A" Offset="0" />
            <GradientStop Color="#4A3412" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="KeyEdgeBrush" Color="#0A0603" />
    <SolidColorBrush x:Key="LedOffBrush" Color="#5A3A12" />
    <SolidColorBrush x:Key="LedOnBrush" Color="#FFB347" />
    <SolidColorBrush x:Key="KnobMarkBrush" Color="#FFB347" />
    <RadialGradientBrush x:Key="KnobBrush" GradientOrigin="0.38,0.3" Center="0.5,0.5" RadiusX="0.65" RadiusY="0.65">
            <GradientStop Color="#5A4020" Offset="0" />
            <GradientStop Color="#2E200F" Offset="0.6" />
            <GradientStop Color="#140D05" Offset="1" />
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="FaderCapBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#6B4A1A" Offset="0" />
            <GradientStop Color="#3A2814" Offset="0.5" />
            <GradientStop Color="#1E1409" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SlotBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#4A3412" Offset="0" />
            <GradientStop Color="#6B4A1A" Offset="0.5" />
            <GradientStop Color="#4A3412" Offset="1" />
    </LinearGradientBrush>
    <CornerRadius x:Key="CardRadius">2</CornerRadius>
    <CornerRadius x:Key="PopupRadius">2</CornerRadius>
    <CornerRadius x:Key="ControlRadius">2</CornerRadius>
    <CornerRadius x:Key="KeyRadius">2</CornerRadius>
    <CornerRadius x:Key="BodyRadius">3</CornerRadius>
    <FontFamily x:Key="UiFont">Cascadia Mono, Consolas, Courier New</FontFamily>
    <!-- Überschreibt die Systemfarben von WPF-UI, damit Texte zum Stil passen -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFB347" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#C98A33" />
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#1A120A" />
</ResourceDictionary>
