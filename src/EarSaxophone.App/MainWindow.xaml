<ui:FluentWindow x:Class="EarSaxophone.App.MainWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  Title="Ear Saxophone"
                  Width="1280" Height="860" MinWidth="1120" MinHeight="720"
                  WindowStartupLocation="CenterScreen"
                  ExtendsContentIntoTitleBar="True"
                  WindowBackdropType="None"
                  Background="{DynamicResource ApplicationBackgroundBrush}"
                  Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelLearnCommand}" />
    </ui:FluentWindow.InputBindings>

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <SolidColorBrush x:Key="AccentBrush" Color="#3FB6A8" />
        <SolidColorBrush x:Key="TileBorder" Color="#2EFFFFFF" />
        <SolidColorBrush x:Key="TileBorderMapped" Color="#66FFFFFF" />
        <SolidColorBrush x:Key="TileBackground" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="TileBackgroundHover" Color="#24FFFFFF" />

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="2,10,0,4" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="8" BorderThickness="1.5"
                                Background="{StaticResource TileBackground}"
                                BorderBrush="{StaticResource TileBorder}"
                                Padding="7,6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource TileBackgroundHover}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding HasMapping}" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource TileBorderMapped}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource TileBackgroundHover}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ElementTile">
            <Button Style="{StaticResource TileButton}"
                    Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
                <StackPanel MinHeight="58">
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Summary}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding LevelFraction, Mode=OneWay}" Height="4" Margin="0,6,0,0"
                                 Visibility="{Binding IsContinuous, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Ear Saxophone" />

        <!-- Kopfzeile: Zeile 1 Verbindung und MIDI-Learn, Zeile 2 Profile -->
        <StackPanel Grid.Row="1" Margin="20,8,20,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="11" Height="11" Margin="0,0,9,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#C75050" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="#4CC38A" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding ConnectionText}" TextWrapping="Wrap" MaxWidth="560" VerticalAlignment="Center" FontSize="13" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="Abbrechen" Margin="0,0,8,0" Command="{Binding CancelLearnCommand}"
                               Visibility="{Binding IsLearning, Converter={StaticResource BoolToVis}}" />
                    <ui:Button Content="Regler wählen (MIDI-Learn)" Appearance="Primary" Command="{Binding LearnCommand}"
                               ToolTip="Danach einen Regler oder eine Taste am Gerät bewegen oder drücken" />
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="Profil" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ComboBox ItemsSource="{Binding ProfileNames}" SelectedItem="{Binding ActiveProfileName, Mode=TwoWay}" MinWidth="170" />
                <TextBlock Text="Name" VerticalAlignment="Center" Margin="16,0,8,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBox Text="{Binding ProfileNameEdit, UpdateSourceTrigger=LostFocus}" MinWidth="170"
                         ToolTip="Name des Profils ändern (mit Enter oder durch Verlassen des Feldes bestätigen)" />
                <ui:Button Content="Neues Profil" Margin="12,0,0,0" Command="{Binding NewProfileCommand}" />
                <ui:Button Content="Profil löschen" Margin="6,0,0,0" Command="{Binding DeleteProfileCommand}" />
            </StackPanel>
        </StackPanel>

        <!-- Hauptbereich: Übersicht links, Editor rechts -->
        <Grid Grid.Row="2" Margin="20,4,20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                <StackPanel>
                    <Border Visibility="{Binding IsLearning, Converter={StaticResource BoolToVis}}" Padding="12,9" Margin="0,4,0,0"
                            CornerRadius="8" Background="#333FB6A8" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                        <TextBlock Text="{Binding LearnHint}" TextWrapping="Wrap" />
                    </Border>

                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" />
                                    <ItemsControl ItemsSource="{Binding Elements}" ItemTemplate="{StaticResource ElementTile}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="{Binding Columns}" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Visibility="{Binding HasExtraElements, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Weitere Regler (per MIDI-Learn erkannt)" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding ExtraElements}" ItemTemplate="{StaticResource ElementTile}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Editor -->
            <Border Grid.Column="1" CornerRadius="10" Padding="16,12" Margin="0,4,0,0"
                    Background="{StaticResource TileBackground}"
                    BorderBrush="{StaticResource TileBorder}" BorderThickness="1">
                <Grid>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Top"
                               Text="Wählen Sie links ein Element oder nutzen Sie MIDI-Learn und bewegen Sie einen Regler am Gerät. Danach legen Sie hier fest, was er tun soll.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="{Binding SelectedElement.Label}" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedElement.Control}" Style="{StaticResource Hint}" />

                            <TextBlock Text="Aktion" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding Editor.KindOptions}" DisplayMemberPath="Text" SelectedValuePath="Value"
                                      SelectedValue="{Binding Editor.Kind, Mode=TwoWay}" />

                            <StackPanel Visibility="{Binding Editor.IsAudio, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Ziel" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding Editor.TargetOptions}" DisplayMemberPath="Text" SelectedValuePath="Value"
                                          SelectedValue="{Binding Editor.Target, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding Editor.IsApplication, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Programmdatei der Anwendung" Style="{StaticResource FieldLabel}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox IsEditable="True" ItemsSource="{Binding Editor.AvailableApps}"
                                              Text="{Binding Editor.AppName, UpdateSourceTrigger=PropertyChanged}" />
                                    <ui:Button Grid.Column="1" Content="Aktualisieren" Margin="8,0,0,0" Command="{Binding RefreshAppsCommand}" />
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Zum Beispiel Discord.exe. Die Liste zeigt Programme, die gerade Audio nutzen. Der Name kann auch eingetragen werden, wenn das Programm noch nicht läuft. Alle Fenster und Prozesse des Programms werden gemeinsam geregelt." />
                            </StackPanel>

                            <StackPanel Visibility="{Binding Editor.IsVolume, Converter={StaticResource BoolToVis}}">
                                <CheckBox Content="Umkehren (oben = leise)" IsChecked="{Binding Editor.Invert}" Margin="0,12,0,0" />
                                <TextBlock Text="Kleinste Lautstärke" Style="{StaticResource FieldLabel}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="52" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Editor.MinPercent}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Editor.MinPercent, StringFormat={}{0:0} %}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="Größte Lautstärke" Style="{StaticResource FieldLabel}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="52" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Editor.MaxPercent}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Editor.MaxPercent, StringFormat={}{0:0} %}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Visibility="{Binding Editor.IsMedia, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Befehl" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding Editor.MediaOptions}" DisplayMemberPath="Text" SelectedValuePath="Value"
                                          SelectedValue="{Binding Editor.Media, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Sendet die systemweite Medientaste. Windows entscheidet, welches Programm sie erhält (zum Beispiel Spotify oder ein Browser-Tab)." />
                            </StackPanel>

                            <StackPanel Visibility="{Binding Editor.IsHotkey, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Tastenkombination" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Editor.HotkeyText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Zum Beispiel Strg+Alt+M, Win+D oder Strg+Umschalt+Esc. Sie wirkt auf das Programm, das gerade im Vordergrund ist." />
                            </StackPanel>

                            <TextBlock Text="{Binding Editor.ValidationMessage}" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="#FF7B72"
                                       Visibility="{Binding Editor.HasValidationMessage, Converter={StaticResource BoolToVis}}" />

                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <ui:Button Content="Übernehmen" Appearance="Primary" Command="{Binding ApplyCommand}" />
                                <ui:Button Content="Testen" Margin="8,0,0,0" Command="{Binding TestCommand}" />
                                <ui:Button Content="Entfernen" Margin="8,0,0,0" Command="{Binding RemoveCommand}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Testen führt die Aktion einmal aus (Lautstärke auf 50 %), ohne zu speichern." />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Fußzeile: Fehler, Status, Einstellungen -->
        <StackPanel Grid.Row="3" Margin="20,0,20,14">
            <Border Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" CornerRadius="8" Padding="14,10" Margin="0,0,0,10"
                    Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <ui:Button Grid.Column="1" Content="Schließen" Margin="12,0,0,0" Command="{Binding DismissErrorCommand}" />
                </Grid>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:ToggleSwitch Content="Mit Windows starten" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" Margin="0,0,22,0" />
                    <ui:ToggleSwitch Content="Im Infobereich bleiben" IsChecked="{Binding KeepInTray, Mode=TwoWay}" Margin="0,0,22,0" />
                    <ui:ToggleSwitch Content="Minimiert starten" IsChecked="{Binding StartMinimized, Mode=TwoWay}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
