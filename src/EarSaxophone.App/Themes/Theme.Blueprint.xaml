<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Stil "Blueprint" (erzeugt; alle Schlüssel müssen in jeder Stil-Datei stehen) -->
    <Color x:Key="AccentColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentStrongBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#123A78" />
    <SolidColorBrush x:Key="CardBrush" Color="#E61A4A94" />
    <SolidColorBrush x:Key="PopupBrush" Color="#FA143F82" />
    <SolidColorBrush x:Key="CardStrokeBrush" Color="#6C9BE0" />
    <SolidColorBrush x:Key="SubtleFillBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="SubtleHoverBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="MutedText" Color="#9FC0F0" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FFB4A8" />
    <SolidColorBrush x:Key="InkBrush" Color="#EAF2FF" />
    <SolidColorBrush x:Key="InkSecondaryBrush" Color="#B7D0F5" />
    <SolidColorBrush x:Key="AppBackdropBrush" Color="#123A78" />
    <LinearGradientBrush x:Key="WindowGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#17458F" Offset="0" />
            <GradientStop Color="#123A78" Offset="0.5" />
            <GradientStop Color="#0E2F63" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BodyBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#143C7C" Offset="0" />
            <GradientStop Color="#0F3270" Offset="0.5" />
            <GradientStop Color="#0C2A60" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="DeviceEdge" Color="#EAF2FF" />
    <SolidColorBrush x:Key="PrintBrush" Color="#EAF2FF" />
    <SolidColorBrush x:Key="PrintSoftBrush" Color="#9FC0F0" />
    <SolidColorBrush x:Key="KeyGlyphBrush" Color="#EAF2FF" />
    <LinearGradientBrush x:Key="KeyBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1A4A94" Offset="0" />
            <GradientStop Color="#143C7C" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="KeyActiveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2B63B8" Offset="0" />
            <GradientStop Color="#1A4A94" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="KeyEdgeBrush" Color="#EAF2FF" />
    <SolidColorBrush x:Key="LedOffBrush" Color="#5F8FD6" />
    <SolidColorBrush x:Key="LedOnBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="KnobMarkBrush" Color="#FFFFFF" />
    <RadialGradientBrush x:Key="KnobBrush" GradientOrigin="0.38,0.3" Center="0.5,0.5" RadiusX="0.65" RadiusY="0.65">
            <GradientStop Color="#2B63B8" Offset="0" />
            <GradientStop Color="#1A4A94" Offset="0.6" />
            <GradientStop Color="#0F3270" Offset="1" />
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="FaderCapBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#EAF2FF" Offset="0" />
            <GradientStop Color="#B7D0F5" Offset="0.5" />
            <GradientStop Color="#7FA6E0" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SlotBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#0A2250" Offset="0" />
            <GradientStop Color="#0E2F63" Offset="0.5" />
            <GradientStop Color="#0A2250" Offset="1" />
    </LinearGradientBrush>
    <CornerRadius x:Key="CardRadius">0</CornerRadius>
    <CornerRadius x:Key="PopupRadius">0</CornerRadius>
    <CornerRadius x:Key="ControlRadius">0</CornerRadius>
    <CornerRadius x:Key="KeyRadius">0</CornerRadius>
    <CornerRadius x:Key="BodyRadius">0</CornerRadius>
    <FontFamily x:Key="UiFont">Cascadia Mono, Consolas, Courier New</FontFamily>
    <!-- Überschreibt die Systemfarben von WPF-UI, damit Texte zum Stil passen -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#EAF2FF" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#B7D0F5" />
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#123A78" />
</ResourceDictionary>
