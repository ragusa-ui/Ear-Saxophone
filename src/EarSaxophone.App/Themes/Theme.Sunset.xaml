<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Stil "Sunset" (erzeugt; alle Schlüssel müssen in jeder Stil-Datei stehen) -->
    <Color x:Key="AccentColor">#FF8A4C</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#FF8A4C" />
    <SolidColorBrush x:Key="AccentStrongBrush" Color="#FFB27F" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2EFF8A4C" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#2A1330" />
    <SolidColorBrush x:Key="CardBrush" Color="#E63A1B40" />
    <SolidColorBrush x:Key="PopupBrush" Color="#FA3A1B40" />
    <SolidColorBrush x:Key="CardStrokeBrush" Color="#5A2C5E" />
    <SolidColorBrush x:Key="SubtleFillBrush" Color="#12FFE9DF" />
    <SolidColorBrush x:Key="SubtleHoverBrush" Color="#26FFE9DF" />
    <SolidColorBrush x:Key="MutedText" Color="#C99AA8" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF6B6B" />
    <SolidColorBrush x:Key="InkBrush" Color="#FFE9DF" />
    <SolidColorBrush x:Key="InkSecondaryBrush" Color="#E0BCC0" />
    <SolidColorBrush x:Key="AppBackdropBrush" Color="#2A1330" />
    <LinearGradientBrush x:Key="WindowGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#351A3C" Offset="0" />
            <GradientStop Color="#2A1330" Offset="0.5" />
            <GradientStop Color="#1D0C22" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BodyBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#4A2450" Offset="0" />
            <GradientStop Color="#33183A" Offset="0.5" />
            <GradientStop Color="#22102A" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="DeviceEdge" Color="#7A3D6A" />
    <SolidColorBrush x:Key="PrintBrush" Color="#FFE9DF" />
    <SolidColorBrush x:Key="PrintSoftBrush" Color="#C99AA8" />
    <SolidColorBrush x:Key="KeyGlyphBrush" Color="#FFE9DF" />
    <LinearGradientBrush x:Key="KeyBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#6A3470" Offset="0" />
            <GradientStop Color="#3A1B40" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="KeyActiveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#8A4A8A" Offset="0" />
            <GradientStop Color="#5A2C5E" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="KeyEdgeBrush" Color="#150718" />
    <SolidColorBrush x:Key="LedOffBrush" Color="#7A3D6A" />
    <SolidColorBrush x:Key="LedOnBrush" Color="#FF5F8A" />
    <SolidColorBrush x:Key="KnobMarkBrush" Color="#2A1330" />
    <RadialGradientBrush x:Key="KnobBrush" GradientOrigin="0.38,0.3" Center="0.5,0.5" RadiusX="0.65" RadiusY="0.65">
            <GradientStop Color="#FFB27F" Offset="0" />
            <GradientStop Color="#FF5F8A" Offset="0.6" />
            <GradientStop Color="#B03A70" Offset="1" />
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="FaderCapBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFB27F" Offset="0" />
            <GradientStop Color="#FF8A4C" Offset="0.5" />
            <GradientStop Color="#C0502A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SlotBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#7A3D6A" Offset="0" />
            <GradientStop Color="#A5527F" Offset="0.5" />
            <GradientStop Color="#7A3D6A" Offset="1" />
    </LinearGradientBrush>
    <CornerRadius x:Key="CardRadius">20</CornerRadius>
    <CornerRadius x:Key="PopupRadius">18</CornerRadius>
    <CornerRadius x:Key="ControlRadius">12</CornerRadius>
    <CornerRadius x:Key="KeyRadius">10</CornerRadius>
    <CornerRadius x:Key="BodyRadius">22</CornerRadius>
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <!-- Überschreibt die Systemfarben von WPF-UI, damit Texte zum Stil passen -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFE9DF" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#E0BCC0" />
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#2A1330" />
</ResourceDictionary>
