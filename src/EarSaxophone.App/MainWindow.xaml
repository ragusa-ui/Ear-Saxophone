<ui:FluentWindow x:Class="EarSaxophone.App.MainWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:local="clr-namespace:EarSaxophone.App"
                  xmlns:loc="clr-namespace:EarSaxophone.Core.Localization;assembly=EarSaxophone.Core"
                  Title="Ear Saxophone"
                  Width="1180" Height="760" MinWidth="1000" MinHeight="640"
                  WindowStartupLocation="CenterScreen"
                  ExtendsContentIntoTitleBar="True"
                  WindowBackdropType="None"
                  FontSize="13"
                  Background="{DynamicResource ApplicationBackgroundBrush}"
                  Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelLearnCommand}" />
    </ui:FluentWindow.InputBindings>

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <local:InverseBooleanConverter x:Key="Inverse" />
        <local:ActionKindSymbolConverter x:Key="KindSymbol" />
        <local:TargetSymbolConverter x:Key="TargetSymbol" />
        <local:OsdPositionAlignmentConverter x:Key="OsdAlign" />

        <!-- Farben: Akzent wie das Programmsymbol, dunkle Karten mit feinem Rand -->
        <Color x:Key="AccentColor">#3FB6A8</Color>
        <SolidColorBrush x:Key="AccentBrush" Color="#3FB6A8" />
        <SolidColorBrush x:Key="AccentStrongBrush" Color="#7FE6D9" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#2E3FB6A8" />
        <SolidColorBrush x:Key="OnAccentBrush" Color="#0E1A1A" />
        <SolidColorBrush x:Key="CardBrush" Color="#D91B1F2C" />
        <SolidColorBrush x:Key="PopupBrush" Color="#FA1D2130" />
        <SolidColorBrush x:Key="CardStrokeBrush" Color="#26FFFFFF" />
        <SolidColorBrush x:Key="SubtleFillBrush" Color="#10FFFFFF" />
        <SolidColorBrush x:Key="SubtleHoverBrush" Color="#22FFFFFF" />
        <SolidColorBrush x:Key="MutedText" Color="#8D96AE" />
        <SolidColorBrush x:Key="DangerBrush" Color="#FF7B72" />

        <LinearGradientBrush x:Key="WindowGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1C2130" Offset="0" />
            <GradientStop Color="#12141C" Offset="0.7" />
            <GradientStop Color="#0F1A1C" Offset="1" />
        </LinearGradientBrush>

        <!-- Schrift: Titel 18, Text 13, Hinweis 11 -->
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedText}" />
            <Setter Property="Margin" Value="2,16,0,6" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{StaticResource MutedText}" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="PopupCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="{StaticResource PopupBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="12" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.5" Color="Black" />
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ein Stil für alle Symbol-Schaltflächen und Symbol-Umschalter (32 x 32, runde Ecken, Akzent bei "an") -->
        <Style x:Key="IconButton" TargetType="ButtonBase">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Root" CornerRadius="8" Background="{TemplateBinding Background}" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SubtleHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                            </Trigger>
                            <Trigger Property="ToggleButton.IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconButtonDanger" TargetType="ButtonBase" BasedOn="{StaticResource IconButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Symbol und Text (z. B. "Hinzufügen"): wie IconButton, aber so breit wie der Inhalt -->
        <Style x:Key="PillButton" TargetType="ButtonBase" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="Auto" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="{StaticResource SubtleFillBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Root" CornerRadius="8" Background="{TemplateBinding Background}" BorderThickness="1"
                                BorderBrush="{StaticResource CardStrokeBrush}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SubtleHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                            </Trigger>
                            <Trigger Property="ToggleButton.IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Eintrag in einem Menü oder einer Auswahlliste: ganze Breite, Symbol + Text links -->
        <Style x:Key="MenuItemButton" TargetType="ButtonBase">
            <Setter Property="Height" Value="38" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Root" CornerRadius="8" Background="{TemplateBinding Background}" Padding="10,0">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SubtleHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Auswahl aus Symbol-Kacheln (Aktionsart) -->
        <Style x:Key="SymbolTileItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Width="46" Height="40" CornerRadius="10" BorderThickness="1"
                                Background="{StaticResource SubtleFillBrush}" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SubtleHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentStrongBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Positionen der Anzeige als kleine Bildschirmsymbole -->
        <Style x:Key="PositionTileItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="{Binding Text}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Width="44" Height="30" CornerRadius="6" BorderThickness="1.5" Padding="4"
                                Background="{StaticResource SubtleFillBrush}" BorderBrush="{StaticResource CardStrokeBrush}">
                            <Border x:Name="Dot" Width="14" Height="6" CornerRadius="2" Background="{StaticResource MutedText}"
                                    HorizontalAlignment="{Binding Value, Converter={StaticResource OsdAlign}, ConverterParameter=H}"
                                    VerticalAlignment="{Binding Value, Converter={StaticResource OsdAlign}, ConverterParameter=V}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SubtleHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Dot" Property="Background" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TileList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Gerätebild: angelehnt an den schwarzen nanoKONTROL2 (flaches schwarzes Gehäuse, helle Knöpfe, weiße Aufdrucke).
             Farben und Maße sind geschätzt; die Lage jedes Elements kommt aus Nanokontrol2Layout (Klickflächen bleiben gleich). -->
        <LinearGradientBrush x:Key="BodyBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2A2B2F" Offset="0" />
            <GradientStop Color="#1E1F22" Offset="0.5" />
            <GradientStop Color="#17181A" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BodyFrontBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#141517" Offset="0" />
            <GradientStop Color="#0B0B0C" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="DeviceEdge" Color="#44464C" />
        <SolidColorBrush x:Key="PrintBrush" Color="#F2F2F2" />
        <SolidColorBrush x:Key="PrintSoftBrush" Color="#A9ACB3" />
        <LinearGradientBrush x:Key="KeyBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#3A3C42" Offset="0" />
            <GradientStop Color="#2A2C31" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="KeyActiveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#5C5F67" Offset="0" />
            <GradientStop Color="#45484F" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="KeyEdgeBrush" Color="#08090A" />
        <SolidColorBrush x:Key="LedOffBrush" Color="#3B2624" />
        <SolidColorBrush x:Key="LedOnBrush" Color="#FF5A4A" />
        <RadialGradientBrush x:Key="KnobBrush" GradientOrigin="0.38,0.3" Center="0.5,0.5" RadiusX="0.65" RadiusY="0.65">
            <GradientStop Color="#E3E5E9" Offset="0" />
            <GradientStop Color="#B4B8C0" Offset="0.6" />
            <GradientStop Color="#8C9099" Offset="1" />
        </RadialGradientBrush>
        <SolidColorBrush x:Key="KnobSkirtBrush" Color="#0E0F11" />
        <LinearGradientBrush x:Key="FaderCapBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E8EAEE" Offset="0" />
            <GradientStop Color="#C3C7CE" Offset="0.5" />
            <GradientStop Color="#9DA1A9" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="TrackBrush" Color="#050506" />

        <!-- Kleines Symbol der Belegung (Art der ersten Aktion, Zahl bei mehreren Aktionen) -->
        <ControlTemplate x:Key="BadgeTemplate" TargetType="ContentControl">
            <Border x:Name="BadgeRoot" Height="20" MinWidth="20" CornerRadius="10" Padding="4,0" Background="{StaticResource AccentBrush}"
                    BorderBrush="#1B1C1F" BorderThickness="1.5" AutomationProperties.AutomationId="Badge"
                    Visibility="{Binding HasMapping, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="{Binding BadgeKind, Converter={StaticResource KindSymbol}}" FontSize="12" Filled="True"
                                   Foreground="{StaticResource OnAccentBrush}" />
                    <TextBlock Text="{Binding ActionCount}" FontSize="11" FontWeight="Bold" Margin="2,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource OnAccentBrush}" AutomationProperties.AutomationId="BadgeCount"
                               Visibility="{Binding ShowsActionCount, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>
        </ControlTemplate>

        <!-- Jedes Element im Bild: anklicken = wählen, belegtes Element ziehen = verschieben/tauschen (Strg = kopieren) -->
        <Style x:Key="ElementButton" TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="AllowDrop" Value="True" />
            <Setter Property="Width" Value="{Binding Width}" />
            <Setter Property="Height" Value="{Binding Height}" />
            <Setter Property="ToolTip" Value="{Binding TooltipText}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
            <Setter Property="AutomationProperties.HelpText" Value="{Binding Summary}" />
            <Setter Property="Command" Value="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="CommandParameter" Value="{Binding}" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Element_PreviewMouseLeftButtonDown" />
            <EventSetter Event="PreviewMouseMove" Handler="Element_PreviewMouseMove" />
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="Element_PreviewMouseLeftButtonUp" />
            <EventSetter Event="DragEnter" Handler="Element_DragOver" />
            <EventSetter Event="DragOver" Handler="Element_DragOver" />
            <EventSetter Event="DragLeave" Handler="Element_DragLeave" />
            <EventSetter Event="Drop" Handler="Element_Drop" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Hover" CornerRadius="14" Margin="-4" Background="Transparent" />
                            <Border x:Name="Ring" CornerRadius="14" Margin="-4" BorderThickness="2" BorderBrush="{StaticResource AccentBrush}"
                                    Background="#263FB6A8" Opacity="0" />
                            <Rectangle x:Name="DropRing" Margin="-6" RadiusX="15" RadiusY="15" Stroke="{StaticResource AccentStrongBrush}"
                                       StrokeThickness="2" StrokeDashArray="3 2" Fill="#333FB6A8" Visibility="Collapsed" />
                            <ContentPresenter />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Background" Value="#1CFFFFFF" />
                            </Trigger>
                            <Trigger Property="local:DropTarget.IsActive" Value="True">
                                <Setter TargetName="DropRing" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Drehregler: dunkle Fassung mit Skalenpunkten, heller Knopf, helle Markierungslinie (dreht live mit) -->
        <DataTemplate x:Key="KnobTemplate">
            <Button Style="{StaticResource ElementButton}">
                <Grid>
                    <Ellipse Width="58" Height="58" Stroke="#66FFFFFF" StrokeThickness="2" StrokeDashArray="0.5 3.6" StrokeDashCap="Round"
                             IsHitTestVisible="False" />
                    <Ellipse Width="46" Height="46" Fill="{StaticResource KnobSkirtBrush}" Stroke="#3A3C41" StrokeThickness="1" />
                    <Ellipse Width="38" Height="38" Fill="{StaticResource KnobBrush}" Stroke="#5E626A" StrokeThickness="1" />
                    <Grid Width="38" Height="38" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <RotateTransform Angle="{Binding KnobAngle}" />
                        </Grid.RenderTransform>
                        <Border Width="4" Height="15" Margin="0,2,0,0" VerticalAlignment="Top" HorizontalAlignment="Center"
                                CornerRadius="2" Background="#FFFFFF" BorderBrush="#55000000" BorderThickness="0.8" />
                    </Grid>
                    <ContentControl Template="{StaticResource BadgeTemplate}" Focusable="False" IsHitTestVisible="False"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-6,0" />
                </Grid>
            </Button>
        </DataTemplate>

        <!-- Fader: dunkler Schlitz mit Skalenstrichen, heller Fader-Kopf mit Mittellinie (fährt live mit), Kanalnummer darunter -->
        <DataTemplate x:Key="FaderTemplate">
            <Button Style="{StaticResource ElementButton}">
                <Grid>
                    <Grid Width="22" Margin="0,22,0,46" HorizontalAlignment="Center" IsHitTestVisible="False">
                        <Rectangle Height="1" VerticalAlignment="Top" Fill="#59FFFFFF" />
                        <Rectangle Height="1" VerticalAlignment="Center" Fill="#40FFFFFF" Width="14" />
                        <Rectangle Height="1" VerticalAlignment="Bottom" Fill="#59FFFFFF" />
                    </Grid>
                    <Border Width="6" HorizontalAlignment="Center" Margin="0,14,0,38" CornerRadius="3"
                            Background="{StaticResource TrackBrush}" BorderBrush="#3A3C42" BorderThickness="1" />
                    <Border Width="30" Height="24" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0" CornerRadius="3"
                            Background="{StaticResource FaderCapBrush}" BorderBrush="#1A1B1E" BorderThickness="1">
                        <Border.RenderTransform>
                            <TranslateTransform Y="{Binding CapOffset}" />
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.6" Color="Black" />
                        </Border.Effect>
                        <Rectangle Height="2" Margin="3,0" Fill="#FFFFFF" />
                    </Border>
                    <TextBlock Text="{Binding Caption}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6" FontSize="15"
                               FontWeight="SemiBold" Foreground="{StaticResource PrintBrush}" IsHitTestVisible="False" />
                    <ContentControl Template="{StaticResource BadgeTemplate}" Focusable="False" IsHitTestVisible="False"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-12,4" />
                </Grid>
            </Button>
        </DataTemplate>

        <!-- Taste: rechteckig, abgerundet, weißer Aufdruck; Tasten mit LED am Gerät haben oben eine kleine LED-Fläche,
             die leuchtet, solange das Stumm-Ziel der Taste stumm ist (IsMuteLit). Gedrückt = heller. -->
        <DataTemplate x:Key="KeyTemplate">
            <Button Style="{StaticResource ElementButton}">
                <Grid>
                    <Border x:Name="Key" CornerRadius="5" Margin="2" Background="{StaticResource KeyBrush}"
                            BorderBrush="{StaticResource KeyEdgeBrush}" BorderThickness="1">
                        <Border CornerRadius="4" BorderBrush="#24FFFFFF" BorderThickness="0,1,0,0" />
                    </Border>
                    <Border x:Name="Led" Width="16" Height="4" CornerRadius="2" Margin="0,6,0,0" VerticalAlignment="Top" HorizontalAlignment="Center"
                            Background="{StaticResource LedOffBrush}" IsHitTestVisible="False" AutomationProperties.AutomationId="KeyLed"
                            Visibility="{Binding HasLed, Converter={StaticResource BoolToVis}}" />
                    <Border x:Name="LedOn" Width="16" Height="4" CornerRadius="2" Margin="0,6,0,0" VerticalAlignment="Top" HorizontalAlignment="Center"
                            Background="{StaticResource LedOnBrush}" IsHitTestVisible="False" AutomationProperties.AutomationId="KeyLedOn"
                            Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.9" Color="#FF5A4A" />
                        </Border.Effect>
                    </Border>
                    <TextBlock x:Name="GlyphText" Text="{Binding Glyph}" Foreground="{StaticResource PrintBrush}" FontSize="13" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <ContentControl Template="{StaticResource BadgeTemplate}" Focusable="False" IsHitTestVisible="False"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-7,-7,0" />
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasLed}" Value="True">
                    <Setter TargetName="GlyphText" Property="Margin" Value="0,7,0,0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Height}" Value="44">
                    <Setter TargetName="GlyphText" Property="FontSize" Value="16" />
                    <Setter TargetName="Led" Property="Margin" Value="0,7,0,0" />
                    <Setter TargetName="LedOn" Property="Margin" Value="0,7,0,0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMuteLit}" Value="True">
                    <Setter TargetName="LedOn" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasLed}" Value="False">
                    <Setter TargetName="LedOn" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <!-- Blinken bei Stumm: in der dunklen Phase bleibt KeyLedOn sichtbar (IsMuteLit), wird aber ausgeblendet (Opacity). -->
                <DataTrigger Binding="{Binding IsLedBlinkOff}" Value="True">
                    <Setter TargetName="LedOn" Property="Opacity" Value="0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="Key" Property="Background" Value="{StaticResource KeyActiveBrush}" />
                    <Setter TargetName="Key" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Per MIDI-Learn gefundene Regler, die nicht im Bild sind -->
        <DataTemplate x:Key="ExtraTemplate">
            <Button Style="{StaticResource ElementButton}" Margin="0,0,12,8">
                <Grid>
                    <Border x:Name="Key" CornerRadius="8" Background="{StaticResource KeyBrush}" BorderBrush="#5A647F" BorderThickness="1" Padding="10,0,28,0">
                        <TextBlock Text="{Binding Label}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Border>
                    <ContentControl Template="{StaticResource BadgeTemplate}" Focusable="False" IsHitTestVisible="False"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" />
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="Key" Property="Background" Value="{StaticResource KeyActiveBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <local:ElementTemplateSelector x:Key="ElementSelector" Knob="{StaticResource KnobTemplate}"
                                       Fader="{StaticResource FaderTemplate}" Button="{StaticResource KeyTemplate}" />
    </ui:FluentWindow.Resources>

    <Grid Background="{StaticResource WindowGradient}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="WindowTitleBar" Grid.Row="0" Title="Ear Saxophone">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Kopfzeile: Verbindung links; Profil, Neu verbinden, MIDI-Learn und Zahnrad rechts -->
        <Grid x:Name="HeaderBar" Grid.Row="1" Margin="16,2,16,10" Height="36">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border x:Name="ConnectionStatus" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Height="32"
                    CornerRadius="16" Padding="12,0,14,0" Background="{StaticResource SubtleFillBrush}"
                    BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="1" Margin="0,0,12,0"
                    ToolTip="{Binding ConnectionText}" AutomationProperties.AutomationId="ConnectionStatus">
                <DockPanel VerticalAlignment="Center">
                    <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Margin="0,0,9,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#E0605A" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="#4CC38A" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock x:Name="ConnectionTextBlock" Text="{Binding ConnectionText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               AutomationProperties.AutomationId="ConnectionText" />
                </DockPanel>
            </Border>

            <!-- Profil: kleines Auswahlfeld, Verwalten im Menü -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                <ui:SymbolIcon Symbol="Person20" FontSize="16" Margin="0,0,8,0" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" />
                <ComboBox x:Name="ProfilePicker" Width="170" Height="32" MinHeight="0" Padding="10,4" VerticalContentAlignment="Center"
                          ItemsSource="{Binding ProfileNames}" SelectedItem="{Binding ActiveProfileName, Mode=TwoWay}"
                          ToolTip="{x:Static loc:Texts.UiProfile}" AutomationProperties.AutomationId="ProfilePicker"
                          AutomationProperties.Name="{x:Static loc:Texts.UiProfile}" />
                <ToggleButton x:Name="ProfileMenuButton" Style="{StaticResource IconButton}" Margin="4,0,0,0"
                              ToolTip="{x:Static loc:Texts.UiProfileMenu}" AutomationProperties.AutomationId="ProfileMenuButton"
                              AutomationProperties.Name="{x:Static loc:Texts.UiProfileMenu}"
                              IsHitTestVisible="{Binding IsOpen, ElementName=ProfilePopup, Converter={StaticResource Inverse}}">
                    <ui:SymbolIcon Symbol="MoreHorizontal20" />
                </ToggleButton>
                <Popup x:Name="ProfilePopup" PlacementTarget="{Binding ElementName=ProfileMenuButton}" Placement="Bottom"
                       HorizontalOffset="-150" VerticalOffset="2" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                       IsOpen="{Binding IsChecked, ElementName=ProfileMenuButton, Mode=TwoWay}">
                    <Border Style="{StaticResource PopupCard}" Width="290">
                        <StackPanel>
                            <TextBlock Text="{x:Static loc:Texts.UiProfileRename}" Style="{StaticResource SectionLabel}" Margin="2,0,0,6" />
                            <ui:TextBox x:Name="ProfileNameBox" Text="{Binding ProfileNameEdit, UpdateSourceTrigger=LostFocus}"
                                        Icon="{ui:SymbolIcon Rename20}" ToolTip="{x:Static loc:Texts.UiProfileRenameTip}"
                                        KeyDown="ProfileNameBox_KeyDown" AutomationProperties.AutomationId="ProfileNameBox"
                                        AutomationProperties.Name="{x:Static loc:Texts.UiProfileRename}" />
                            <Separator Margin="0,14,0,10" Opacity="0.4" />
                            <ui:Button x:Name="NewProfileButton" Content="{x:Static loc:Texts.UiNewProfile}" Icon="{ui:SymbolIcon Add20}"
                                       HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding NewProfileCommand}"
                                       AutomationProperties.AutomationId="NewProfileButton" />
                            <ui:Button x:Name="DeleteProfileButton" Content="{x:Static loc:Texts.UiDeleteProfile}" Icon="{ui:SymbolIcon Delete20}"
                                       Margin="0,6,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                       Command="{Binding DeleteProfileCommand}" AutomationProperties.AutomationId="DeleteProfileButton" />
                        </StackPanel>
                    </Border>
                </Popup>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button x:Name="ReconnectButton" Content="{x:Static loc:Texts.UiReconnect}" Icon="{ui:SymbolIcon PlugConnected20}" Height="32"
                           Command="{Binding ReconnectCommand}" ToolTip="{x:Static loc:Texts.UiReconnectTip}"
                           AutomationProperties.AutomationId="ReconnectButton" />
                <ui:Button x:Name="LearnButton" Content="{x:Static loc:Texts.UiLearn}" Icon="{ui:SymbolIcon TapSingle20}" Height="32" Margin="8,0,0,0"
                           Command="{Binding LearnCommand}" ToolTip="{x:Static loc:Texts.UiLearnTip}"
                           Visibility="{Binding IsLearning, Converter={StaticResource InverseBoolToVis}}"
                           AutomationProperties.AutomationId="LearnButton" />
                <ui:Button x:Name="CancelLearnButton" Content="{x:Static loc:Texts.UiCancel}" Icon="{ui:SymbolIcon Dismiss20}" Height="32" Margin="8,0,0,0"
                           Appearance="Primary" Command="{Binding CancelLearnCommand}"
                           Visibility="{Binding IsLearning, Converter={StaticResource BoolToVis}}"
                           AutomationProperties.AutomationId="CancelLearnButton" />
            </StackPanel>

            <!-- Zahnrad: alle Einstellungen -->
            <Grid Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center">
                <ToggleButton x:Name="SettingsButton" Style="{StaticResource IconButton}" ToolTip="{x:Static loc:Texts.UiSettings}"
                              AutomationProperties.AutomationId="SettingsButton" AutomationProperties.Name="{x:Static loc:Texts.UiSettings}"
                              IsHitTestVisible="{Binding IsOpen, ElementName=SettingsPopup, Converter={StaticResource Inverse}}">
                    <ui:SymbolIcon Symbol="Settings20" FontSize="18" />
                </ToggleButton>
                <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsButton}" Placement="Bottom"
                       HorizontalOffset="-330" VerticalOffset="2" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                       IsOpen="{Binding IsChecked, ElementName=SettingsButton, Mode=TwoWay}">
                    <Border x:Name="SettingsPanel" Style="{StaticResource PopupCard}" Width="344">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <ui:SymbolIcon Symbol="Settings20" FontSize="18" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0" />
                                <TextBlock Text="{x:Static loc:Texts.UiSettings}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>

                            <ui:ToggleSwitch x:Name="ShowOsdToggle" Content="{x:Static loc:Texts.UiOsdToggle}" IsChecked="{Binding ShowOsd, Mode=TwoWay}"
                                             Margin="0,12,0,0" AutomationProperties.AutomationId="ShowOsdToggle" />
                            <TextBlock Text="{x:Static loc:Texts.UiOsdPosition}" Style="{StaticResource SectionLabel}" Margin="2,12,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ListBox x:Name="OsdPositionPicker" Style="{StaticResource TileList}" ItemContainerStyle="{StaticResource PositionTileItem}"
                                         ItemsSource="{Binding OsdPositionOptions}" SelectedValuePath="Value"
                                         SelectedValue="{Binding OsdPosition, Mode=TwoWay}" Width="150" HorizontalAlignment="Left"
                                         AutomationProperties.AutomationId="OsdPositionPicker" AutomationProperties.Name="{x:Static loc:Texts.UiOsdPosition}">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3" Rows="2" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                </ListBox>
                                <ui:Button x:Name="TestOsdButton" Grid.Column="1" Content="{x:Static loc:Texts.UiOsdTest}" Icon="{ui:SymbolIcon Eye20}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding TestOsdCommand}"
                                           AutomationProperties.AutomationId="TestOsdButton" />
                            </Grid>

                            <Separator Margin="0,10,0,6" Opacity="0.4" />
                            <ui:ToggleSwitch x:Name="StartWithWindowsToggle" Content="{x:Static loc:Texts.UiStartWithWindows}"
                                             IsChecked="{Binding StartWithWindows, Mode=TwoWay}" Margin="0,6,0,0"
                                             AutomationProperties.AutomationId="StartWithWindowsToggle" />
                            <ui:ToggleSwitch x:Name="KeepInTrayToggle" Content="{x:Static loc:Texts.UiKeepInTray}"
                                             IsChecked="{Binding KeepInTray, Mode=TwoWay}" Margin="0,10,0,0"
                                             AutomationProperties.AutomationId="KeepInTrayToggle" />
                            <ui:ToggleSwitch x:Name="StartMinimizedToggle" Content="{x:Static loc:Texts.UiStartMinimized}"
                                             IsChecked="{Binding StartMinimized, Mode=TwoWay}" Margin="0,10,0,0"
                                             AutomationProperties.AutomationId="StartMinimizedToggle" />
                            <ui:ToggleSwitch x:Name="LedFeedbackToggle" Content="{x:Static loc:Texts.UiLedFeedback}" ToolTip="{x:Static loc:Texts.UiLedFeedbackTip}"
                                             IsChecked="{Binding LedFeedback, Mode=TwoWay}" Margin="0,10,0,0"
                                             AutomationProperties.AutomationId="LedFeedbackToggle" />
                            <ui:ToggleSwitch x:Name="LedBlinkToggle" Content="{x:Static loc:Texts.UiLedBlink}" ToolTip="{x:Static loc:Texts.UiLedBlinkTip}"
                                             IsChecked="{Binding LedBlink, Mode=TwoWay}" Margin="0,10,0,0"
                                             AutomationProperties.AutomationId="LedBlinkToggle" />

                            <Separator Margin="0,14,0,6" Opacity="0.4" />
                            <ui:ToggleSwitch x:Name="AskForNewProgramsToggle" Content="{x:Static loc:Texts.UiAskForNewPrograms}"
                                             IsChecked="{Binding AskForNewPrograms, Mode=TwoWay}" Margin="0,6,0,0"
                                             AutomationProperties.AutomationId="AskForNewProgramsToggle" />
                            <ui:ToggleSwitch x:Name="PromptSoundToggle" Content="{x:Static loc:Texts.UiPromptSound}"
                                             IsChecked="{Binding PromptSound, Mode=TwoWay}" Margin="0,6,0,0"
                                             AutomationProperties.AutomationId="PromptSoundToggle" />
                            <ui:Button x:Name="ResetIgnoredButton" Content="{x:Static loc:Texts.UiResetIgnoredPrograms}" Icon="{ui:SymbolIcon ArrowReset20}"
                                       Margin="0,10,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                       Command="{Binding ResetIgnoredProgramsCommand}" IsEnabled="{Binding HasIgnoredPrograms}"
                                       AutomationProperties.AutomationId="ResetIgnoredButton" />

                            <!-- Updates: Version, Suche, Installation, automatische Prüfung -->
                            <Separator Margin="0,14,0,6" Opacity="0.4" />
                            <StackPanel x:Name="UpdateSection" AutomationProperties.AutomationId="UpdateSection">
                                <TextBlock Text="{x:Static loc:Texts.UiUpdates}" Style="{StaticResource SectionLabel}" Margin="2,6,0,4" />
                                <TextBlock x:Name="UpdateInstalledText" Text="{Binding Update.InstalledVersionText}" Style="{StaticResource Hint}" Margin="2,0,0,0"
                                           AutomationProperties.AutomationId="UpdateInstalledText" />
                                <TextBlock x:Name="UpdateStatusText" Text="{Binding Update.StatusText}" TextWrapping="Wrap" Margin="2,6,0,0"
                                           Visibility="{Binding Update.HasStatusText, Converter={StaticResource BoolToVis}}"
                                           AutomationProperties.AutomationId="UpdateStatusText" />
                                <ui:Button x:Name="CheckForUpdatesButton" Content="{x:Static loc:Texts.UiCheckForUpdates}" Icon="{ui:SymbolIcon ArrowSync20}"
                                           Margin="0,10,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                           Command="{Binding Update.CheckCommand}" AutomationProperties.AutomationId="CheckForUpdatesButton" />
                                <ui:Button x:Name="GearInstallUpdateButton" Content="{x:Static loc:Texts.UiInstallUpdate}" Icon="{ui:SymbolIcon ArrowDownload20}"
                                           Appearance="Primary" Margin="0,6,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                           Command="{Binding Update.InstallCommand}" ToolTip="{x:Static loc:Texts.UiInstallUpdateTip}"
                                           Visibility="{Binding Update.IsUpdateAvailable, Converter={StaticResource BoolToVis}}"
                                           AutomationProperties.AutomationId="GearInstallUpdateButton" />
                                <ui:ToggleSwitch x:Name="CheckUpdatesOnStartToggle" Content="{x:Static loc:Texts.UiCheckForUpdatesOnStart}"
                                                 IsChecked="{Binding Update.CheckOnStart, Mode=TwoWay}" Margin="0,10,0,0"
                                                 AutomationProperties.AutomationId="CheckUpdatesOnStartToggle" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Grid>

        <!-- Hauptbereich: Gerätebild links, Seitenpanel rechts -->
        <Grid Grid.Row="2" Margin="16,0,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="344" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <!-- Neue Version verfügbar (oder Update läuft): dezenter Hinweis mit "Jetzt aktualisieren" und Fortschritt -->
                    <Border x:Name="UpdateBanner" Visibility="{Binding Update.ShowBanner, Converter={StaticResource BoolToVis}}" Padding="14,6,6,6"
                            Margin="0,0,0,8" CornerRadius="12" Background="{StaticResource SubtleFillBrush}" BorderBrush="{StaticResource CardStrokeBrush}"
                            BorderThickness="1" AutomationProperties.AutomationId="UpdateBanner">
                        <DockPanel>
                            <ui:SymbolIcon DockPanel.Dock="Left" Symbol="ArrowCircleUp20" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource AccentStrongBrush}" />
                            <Button x:Name="DismissUpdateButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Margin="4,0,0,0"
                                    Command="{Binding Update.DismissCommand}" ToolTip="{x:Static loc:Texts.UiDismissUpdate}"
                                    Visibility="{Binding Update.IsInstalling, Converter={StaticResource InverseBoolToVis}}"
                                    AutomationProperties.AutomationId="DismissUpdateButton" AutomationProperties.Name="{x:Static loc:Texts.UiDismissUpdate}">
                                <ui:SymbolIcon Symbol="Dismiss20" />
                            </Button>
                            <ui:Button x:Name="InstallUpdateButton" DockPanel.Dock="Right" Content="{x:Static loc:Texts.UiInstallUpdate}"
                                       Icon="{ui:SymbolIcon ArrowDownload20}" Appearance="Primary" Height="30" Command="{Binding Update.InstallCommand}"
                                       ToolTip="{x:Static loc:Texts.UiInstallUpdateTip}"
                                       Visibility="{Binding Update.IsInstalling, Converter={StaticResource InverseBoolToVis}}"
                                       AutomationProperties.AutomationId="InstallUpdateButton" />
                            <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock x:Name="UpdateBannerText" Text="{Binding Update.BannerText}" TextTrimming="CharacterEllipsis"
                                           AutomationProperties.AutomationId="UpdateBannerText" />
                                <ProgressBar x:Name="UpdateProgress" Minimum="0" Maximum="1" Value="{Binding Update.Progress, Mode=OneWay}" Height="4"
                                             Margin="0,6,0,2" Visibility="{Binding Update.IsInstalling, Converter={StaticResource BoolToVis}}"
                                             AutomationProperties.AutomationId="UpdateProgress" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- MIDI-Learn läuft -->
                    <Border x:Name="LearnBanner" Visibility="{Binding IsLearning, Converter={StaticResource BoolToVis}}" Padding="14,10"
                            Margin="0,0,0,8" CornerRadius="12" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="1" AutomationProperties.AutomationId="LearnBanner">
                        <DockPanel>
                            <ui:SymbolIcon DockPanel.Dock="Left" Symbol="TapSingle20" FontSize="18" Margin="0,0,10,0" Foreground="{StaticResource AccentStrongBrush}" />
                            <TextBlock x:Name="LearnHintText" Text="{Binding LearnHint}" TextWrapping="Wrap" VerticalAlignment="Center"
                                       AutomationProperties.AutomationId="LearnHint" />
                        </DockPanel>
                    </Border>

                    <!-- Am Gerät wurde ein anderes Element bedient, während die Bearbeitung offen ist -->
                    <Border x:Name="PendingBanner" Visibility="{Binding HasPendingSelection, Converter={StaticResource BoolToVis}}" Padding="14,6,8,6"
                            Margin="0,0,0,8" CornerRadius="12" Background="{StaticResource SubtleFillBrush}" BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="1" AutomationProperties.AutomationId="PendingBanner">
                        <DockPanel>
                            <ui:SymbolIcon DockPanel.Dock="Left" Symbol="CursorClick20" FontSize="18" Margin="0,0,10,0" Foreground="{StaticResource AccentStrongBrush}" />
                            <ui:Button x:Name="SelectPendingButton" DockPanel.Dock="Right" Content="{x:Static loc:Texts.UiSelectPending}"
                                       Icon="{ui:SymbolIcon ArrowEnter20}" Command="{Binding SelectPendingCommand}" Height="30"
                                       AutomationProperties.AutomationId="SelectPendingButton" />
                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                <Run Text="{x:Static loc:Texts.UiPendingHint}" Foreground="{StaticResource MutedText}" />
                                <Run Text="{Binding PendingElement.Label, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- Das Gerät als Bild -->
                <Viewbox x:Name="DeviceView" Grid.Row="1" Stretch="Uniform" Margin="4,6,4,6" AutomationProperties.AutomationId="DeviceView">
                    <Grid Width="1000" Height="460" Margin="12">
                        <!-- Gehäuse: flach und schwarz, oben eine feine Lichtkante, unten die schmale Vorderkante (Slim-Line) -->
                        <Border CornerRadius="18" Background="{StaticResource BodyBrush}" BorderBrush="{StaticResource DeviceEdge}" BorderThickness="1.5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="36" ShadowDepth="10" Opacity="0.6" Color="Black" />
                            </Border.Effect>
                        </Border>
                        <Border CornerRadius="17,17,0,0" Margin="1.5" Height="2" VerticalAlignment="Top" Background="#1AFFFFFF" IsHitTestVisible="False" />
                        <Border CornerRadius="0,0,17,17" Margin="1.5" Height="12" VerticalAlignment="Bottom" Background="{StaticResource BodyFrontBrush}"
                                IsHitTestVisible="False" />
                        <!-- Aufdrucke auf dem Gehäuse (Lage passend zu Nanokontrol2Layout) -->
                        <Canvas IsHitTestVisible="False">
                            <TextBlock Canvas.Left="34" Canvas.Top="26" Width="134" TextAlignment="Center" Text="TRACK" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrintBrush}" />
                            <Rectangle Canvas.Left="34" Canvas.Top="33" Width="40" Height="1" Fill="#66FFFFFF" />
                            <Rectangle Canvas.Left="128" Canvas.Top="33" Width="40" Height="1" Fill="#66FFFFFF" />
                            <TextBlock Canvas.Left="178" Canvas.Top="26" Width="62" TextAlignment="Center" Text="CYCLE" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrintBrush}" />
                            <TextBlock Canvas.Left="34" Canvas.Top="106" Width="206" TextAlignment="Center" Text="MARKER" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrintBrush}" />
                            <Rectangle Canvas.Left="34" Canvas.Top="113" Width="72" Height="1" Fill="#66FFFFFF" />
                            <Rectangle Canvas.Left="168" Canvas.Top="113" Width="72" Height="1" Fill="#66FFFFFF" />
                            <Rectangle Canvas.Left="34" Canvas.Top="200" Width="206" Height="1" Fill="#26FFFFFF" />
                            <Rectangle Canvas.Left="288" Canvas.Top="30" Width="1.5" Height="400" Fill="#24FFFFFF" />
                            <TextBlock Canvas.Left="34" Canvas.Top="390" Text="nanoKONTROL2" FontSize="19" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrintBrush}" />
                        </Canvas>
                        <ItemsControl x:Name="DeviceElements" ItemsSource="{Binding Elements}" ItemTemplateSelector="{StaticResource ElementSelector}"
                                      Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>
                    </Grid>
                </Viewbox>

                <!-- Weitere Regler (per MIDI-Learn gefunden) -->
                <StackPanel x:Name="ExtraPanel" Grid.Row="2" Visibility="{Binding HasExtraElements, Converter={StaticResource BoolToVis}}" Margin="4,0,4,4">
                    <TextBlock Text="{x:Static loc:Texts.UiExtraControls}" Style="{StaticResource SectionLabel}" Margin="2,0,0,6" />
                    <ItemsControl x:Name="ExtraElementList" ItemsSource="{Binding ExtraElements}" ItemTemplate="{StaticResource ExtraTemplate}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Margin="4,4,0,0" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="6,0,0,0">
                    <ui:SymbolIcon Symbol="HandDraw20" FontSize="13" Foreground="{StaticResource MutedText}" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Static loc:Texts.UiDragHint}" Style="{StaticResource Hint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- Seitenpanel: was liegt auf dem gewählten Element -->
            <Border x:Name="SidePanel" Grid.Column="2" Style="{StaticResource Card}" AutomationProperties.AutomationId="SidePanel">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Titel des Elements und Nadel (Auswahl anpinnen = nicht dem Gerät folgen) -->
                    <Grid Grid.Row="0" Margin="18,14,12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center">
                            <TextBlock x:Name="EditorTitle" Text="{Binding SelectedElement.Label}" Style="{StaticResource PanelTitle}"
                                       AutomationProperties.AutomationId="EditorTitle" />
                            <TextBlock x:Name="EditorSummary" Text="{Binding SelectedElement.Summary}" Style="{StaticResource Hint}" TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0" AutomationProperties.AutomationId="EditorSummary" />
                        </StackPanel>
                        <ToggleButton x:Name="FollowDeviceToggle" Grid.Column="1" VerticalAlignment="Top"
                                      IsChecked="{Binding FollowDevice, Mode=TwoWay, Converter={StaticResource Inverse}}"
                                      AutomationProperties.AutomationId="FollowDeviceToggle" AutomationProperties.Name="{x:Static loc:Texts.UiPinSelection}">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton" BasedOn="{StaticResource IconButton}">
                                    <Setter Property="ToolTip" Value="{x:Static loc:Texts.UiFollowDevice}" />
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="ToolTip" Value="{x:Static loc:Texts.UiPinSelection}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                            <ui:SymbolIcon Symbol="Pin20" Filled="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                        </ToggleButton>
                    </Grid>

                    <!-- Nichts gewählt -->
                    <StackPanel x:Name="SelectPrompt" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                                Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}">
                        <ui:SymbolIcon Symbol="CursorClick24" FontSize="36" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{x:Static loc:Texts.UiSelectPrompt}" Style="{StaticResource Hint}" FontSize="13" TextAlignment="Center"
                                   Margin="0,12,0,0" MaxWidth="240" />
                    </StackPanel>

                    <ScrollViewer x:Name="EditorScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="18,0,18,12">
                            <!-- Art der Aktion: nur, was zum Element passt -->
                            <StackPanel Visibility="{Binding Editor.HasKindChoice, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{x:Static loc:Texts.UiActionKind}" Style="{StaticResource SectionLabel}" Margin="2,4,0,6" />
                                <ListBox x:Name="KindPicker" Style="{StaticResource TileList}" ItemContainerStyle="{StaticResource SymbolTileItem}"
                                         ItemsSource="{Binding Editor.KindOptions}" SelectedValuePath="Value"
                                         SelectedValue="{Binding Editor.Kind, Mode=TwoWay}"
                                         AutomationProperties.AutomationId="KindPicker" AutomationProperties.Name="{x:Static loc:Texts.UiActionKind}">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <ui:SymbolIcon Symbol="{Binding Value, Converter={StaticResource KindSymbol}}" FontSize="18"
                                                           ToolTip="{Binding Text}" AutomationProperties.Name="{Binding Text}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="KindText" Text="{Binding SelectedItem.Text, ElementName=KindPicker}" FontWeight="SemiBold" Margin="2,0,0,0"
                                           AutomationProperties.AutomationId="KindText" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="2,4,0,0"
                                        Visibility="{Binding Editor.HasKindChoice, Converter={StaticResource InverseBoolToVis}}">
                                <ui:SymbolIcon Symbol="{Binding Editor.Kind, Converter={StaticResource KindSymbol}}" FontSize="18"
                                               Foreground="{StaticResource AccentStrongBrush}" Margin="0,0,8,0" />
                                <TextBlock x:Name="FixedKindText" Text="{Binding Editor.KindOptions[0].Text}" FontWeight="SemiBold" VerticalAlignment="Center"
                                           AutomationProperties.AutomationId="FixedKindText" />
                            </StackPanel>

                            <!-- Ziele (Lautstärke, Stumm): mehrere Programme oder Geräte auf einem Element -->
                            <StackPanel x:Name="TargetSection" Visibility="{Binding Editor.IsAudio, Converter={StaticResource BoolToVis}}">
                                <TextBlock x:Name="TargetHeading" Text="{x:Static loc:Texts.UiTargets}" Style="{StaticResource SectionLabel}" FontSize="13"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" AutomationProperties.AutomationId="TargetHeading" />
                                <ItemsControl x:Name="TargetList" ItemsSource="{Binding Editor.Targets}" Focusable="False"
                                              AutomationProperties.AutomationId="TargetList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="10" Background="{StaticResource SubtleFillBrush}" Padding="10,2,4,2" Margin="0,0,0,4"
                                                    ToolTip="{Binding Name}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ui:SymbolIcon Symbol="{Binding Symbol, Converter={StaticResource TargetSymbol}}" FontSize="16"
                                                                   Foreground="{StaticResource AccentStrongBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="10,0,6,0" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="TargetName" />
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding DataContext.Editor.Targets.Count, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="1">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="13"
                                                                ToolTip="{x:Static loc:Texts.UiMoveUp}" AutomationProperties.AutomationId="MoveTargetUpButton"
                                                                AutomationProperties.Name="{x:Static loc:Texts.UiMoveUp}"
                                                                Command="{Binding DataContext.Editor.MoveTargetUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}">
                                                            <ui:SymbolIcon Symbol="ArrowUp16" />
                                                        </Button>
                                                        <Button Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="13"
                                                                ToolTip="{x:Static loc:Texts.UiMoveDown}" AutomationProperties.AutomationId="MoveTargetDownButton"
                                                                AutomationProperties.Name="{x:Static loc:Texts.UiMoveDown}"
                                                                Command="{Binding DataContext.Editor.MoveTargetDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}">
                                                            <ui:SymbolIcon Symbol="ArrowDown16" />
                                                        </Button>
                                                    </StackPanel>
                                                    <Button Grid.Column="3" Style="{StaticResource IconButtonDanger}" Width="28" Height="28" FontSize="13"
                                                            ToolTip="{x:Static loc:Texts.UiRemoveTarget}" AutomationProperties.AutomationId="RemoveTargetButton"
                                                            AutomationProperties.Name="{x:Static loc:Texts.UiRemoveTarget}"
                                                            Command="{Binding DataContext.Editor.RemoveTargetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}">
                                                        <ui:SymbolIcon Symbol="Dismiss16" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{x:Static loc:Texts.UiNoTargets}" Style="{StaticResource Hint}" Margin="2,0,0,6"
                                           Visibility="{Binding Editor.HasTargets, Converter={StaticResource InverseBoolToVis}}" />

                                <!-- Hinzufügen: ein Menü mit drei eindeutigen Einträgen (Programm, Lautsprecher, Mikrofon) -->
                                <ToggleButton x:Name="AddTargetButton" Style="{StaticResource PillButton}" Margin="0,4,0,0" HorizontalAlignment="Left"
                                              ToolTip="{x:Static loc:Texts.UiAddTargetTip}" AutomationProperties.AutomationId="AddTargetButton"
                                              AutomationProperties.Name="{x:Static loc:Texts.UiAddTarget}"
                                              IsHitTestVisible="{Binding IsOpen, ElementName=AddTargetPopup, Converter={StaticResource Inverse}}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Add20" FontSize="16" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Static loc:Texts.UiAddTarget}" Margin="8,0,8,0" VerticalAlignment="Center" FontSize="13" />
                                        <ui:SymbolIcon Symbol="ChevronDown16" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" />
                                    </StackPanel>
                                </ToggleButton>
                                <Popup x:Name="AddTargetPopup" PlacementTarget="{Binding ElementName=AddTargetButton}" Placement="Bottom"
                                       HorizontalOffset="-12" VerticalOffset="-6" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                                       IsOpen="{Binding IsChecked, ElementName=AddTargetButton, Mode=TwoWay}">
                                    <Border Style="{StaticResource PopupCard}" Padding="6" Width="316" AutomationProperties.AutomationId="AddTargetMenu">
                                        <StackPanel>
                                            <Button x:Name="AddStripItem" Style="{StaticResource MenuItemButton}" Click="AddTargetItem_Click"
                                                    Command="{Binding Editor.AddStripTargetCommand}" AutomationProperties.AutomationId="AddStripItem"
                                                    AutomationProperties.Name="{x:Static loc:Texts.UiAddStripItem}" ToolTip="{x:Static loc:Texts.UiAddStripItemTip}"
                                                    Visibility="{Binding Editor.CanAddStripTarget, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Link20" FontSize="18" Foreground="{StaticResource AccentStrongBrush}" />
                                                    <TextBlock Text="{Binding Editor.StripTargetText}" Margin="12,0,0,0" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="250" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="AddProgramItem" Style="{StaticResource MenuItemButton}" Click="AddTargetItem_Click"
                                                    Command="{Binding Editor.ShowProgramChoiceCommand}" AutomationProperties.AutomationId="AddProgramItem"
                                                    AutomationProperties.Name="{x:Static loc:Texts.UiAddProgramItem}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="AppGeneric20" FontSize="18" Foreground="{StaticResource AccentStrongBrush}" />
                                                    <TextBlock Text="{x:Static loc:Texts.UiAddProgramItem}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="AddSpeakersItem" Style="{StaticResource MenuItemButton}" Click="AddTargetItem_Click"
                                                    Command="{Binding Editor.AddSpeakersCommand}" AutomationProperties.AutomationId="AddSpeakersItem"
                                                    AutomationProperties.Name="{x:Static loc:Texts.UiAddSpeakersItem}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Speaker220" FontSize="18" Foreground="{StaticResource AccentStrongBrush}" />
                                                    <TextBlock Text="{x:Static loc:Texts.UiAddSpeakersItem}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="AddMicrophoneItem" Style="{StaticResource MenuItemButton}" Click="AddTargetItem_Click"
                                                    Command="{Binding Editor.AddMicrophoneCommand}" AutomationProperties.AutomationId="AddMicrophoneItem"
                                                    AutomationProperties.Name="{x:Static loc:Texts.UiAddMicrophoneItem}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Mic20" FontSize="18" Foreground="{StaticResource AccentStrongBrush}" />
                                                    <TextBlock Text="{x:Static loc:Texts.UiAddMicrophoneItem}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Popup>

                                <!-- "Programm …": laufende Programme mit Ton, "Datei öffnen …" und (als Unterpunkt) Name eintippen -->
                                <Border x:Name="ProgramPanel" Visibility="{Binding Editor.IsChoosingProgram, Converter={StaticResource BoolToVis}}"
                                        Margin="0,8,0,0" Padding="10,8,8,10" CornerRadius="12" Background="{StaticResource SubtleFillBrush}"
                                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" AutomationProperties.AutomationId="ProgramPanel">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button x:Name="CloseProgramPanelButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28"
                                                    Command="{Binding Editor.HideProgramChoiceCommand}" ToolTip="{x:Static loc:Texts.UiClose}"
                                                    AutomationProperties.AutomationId="CloseProgramPanelButton" AutomationProperties.Name="{x:Static loc:Texts.UiClose}">
                                                <ui:SymbolIcon Symbol="Dismiss16" />
                                            </Button>
                                            <Button x:Name="RefreshProgramsButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28"
                                                    Command="{Binding RefreshAppsCommand}" ToolTip="{x:Static loc:Texts.UiRefreshLists}"
                                                    AutomationProperties.AutomationId="RefreshProgramsButton" AutomationProperties.Name="{x:Static loc:Texts.UiRefreshLists}">
                                                <ui:SymbolIcon Symbol="ArrowSync20" FontSize="14" />
                                            </Button>
                                            <ui:SymbolIcon DockPanel.Dock="Left" Symbol="AppGeneric20" FontSize="16" Foreground="{StaticResource AccentStrongBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock x:Name="ProgramPanelTitle" Text="{x:Static loc:Texts.UiChooseProgram}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                       AutomationProperties.AutomationId="ProgramPanelTitle" />
                                        </DockPanel>
                                        <TextBlock Text="{x:Static loc:Texts.UiChooseProgramHint}" Style="{StaticResource Hint}" Margin="2,6,0,4"
                                                   Visibility="{Binding Editor.HasProgramChoices, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock x:Name="NoProgramsText" Text="{x:Static loc:Texts.UiNoProgramsPlaying}" Style="{StaticResource Hint}" Margin="2,6,0,4"
                                                   Visibility="{Binding Editor.HasProgramChoices, Converter={StaticResource InverseBoolToVis}}"
                                                   AutomationProperties.AutomationId="NoProgramsText" />
                                        <ScrollViewer MaxHeight="176" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl x:Name="ProgramChoiceList" ItemsSource="{Binding Editor.ProgramChoices}" Focusable="False"
                                                          AutomationProperties.AutomationId="ProgramChoiceList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource MenuItemButton}" Height="34"
                                                                Command="{Binding DataContext.Editor.AddAppCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}" ToolTip="{x:Static loc:Texts.UiAddProgram}"
                                                                AutomationProperties.AutomationId="ProgramChoice" AutomationProperties.Name="{Binding}">
                                                            <DockPanel>
                                                                <ui:SymbolIcon DockPanel.Dock="Right" Symbol="Add16" FontSize="14" Foreground="{StaticResource AccentStrongBrush}"
                                                                               VerticalAlignment="Center" />
                                                                <ui:SymbolIcon DockPanel.Dock="Left" Symbol="AppGeneric20" FontSize="16" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding}" Margin="10,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                            </DockPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <ui:Button x:Name="OpenProgramFileButton" Content="{x:Static loc:Texts.UiOpenProgramFile}" Icon="{ui:SymbolIcon FolderOpen20}"
                                                   Margin="0,8,0,0" Height="32" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                   Click="OpenProgramFile_Click" ToolTip="{x:Static loc:Texts.UiOpenProgramFileTip}"
                                                   AutomationProperties.AutomationId="OpenProgramFileButton" />
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:TextBox x:Name="ProgramNameBox" Text="{Binding Editor.NewAppName, UpdateSourceTrigger=PropertyChanged}"
                                                        PlaceholderText="{x:Static loc:Texts.UiProgramPlaceholder}" ToolTip="{x:Static loc:Texts.UiProgramTip}"
                                                        KeyDown="ProgramNameBox_KeyDown" AutomationProperties.AutomationId="ProgramNameBox"
                                                        AutomationProperties.Name="{x:Static loc:Texts.UiProgramPlaceholder}" />
                                            <Button x:Name="AddProgramButton" Grid.Column="1" Style="{StaticResource IconButton}" Margin="4,0,0,0" VerticalAlignment="Center"
                                                    Background="{StaticResource AccentSoftBrush}" Command="{Binding Editor.AddAppCommand}"
                                                    ToolTip="{x:Static loc:Texts.UiAddProgram}" AutomationProperties.AutomationId="AddProgramButton"
                                                    AutomationProperties.Name="{x:Static loc:Texts.UiAddProgram}">
                                                <ui:SymbolIcon Symbol="Add20" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Stumm: Verhalten der Taste -->
                            <StackPanel Visibility="{Binding Editor.IsMute, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{x:Static loc:Texts.UiMuteModeLabel}" Style="{StaticResource SectionLabel}" />
                                <ComboBox x:Name="MuteModePicker" ItemsSource="{Binding Editor.MuteModeOptions}" DisplayMemberPath="Text" SelectedValuePath="Value"
                                          SelectedValue="{Binding Editor.MuteMode, Mode=TwoWay}" AutomationProperties.AutomationId="MuteModePicker"
                                          AutomationProperties.Name="{x:Static loc:Texts.UiMuteModeLabel}" />
                            </StackPanel>

                            <!-- Lautstärke: Bereich und Richtung -->
                            <StackPanel Visibility="{Binding Editor.IsVolume, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                                <ui:ToggleSwitch x:Name="InvertToggle" Content="{x:Static loc:Texts.UiInvert}" IsChecked="{Binding Editor.Invert, Mode=TwoWay}"
                                                 Margin="0,10,0,6" AutomationProperties.AutomationId="InvertToggle" />
                                <Grid Margin="0,4,0,0" ToolTip="{x:Static loc:Texts.UiMinVolume}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="48" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="Speaker020" FontSize="16" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" />
                                    <Slider x:Name="MinVolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding Editor.MinPercent}" VerticalAlignment="Center" AutomationProperties.AutomationId="MinVolumeSlider"
                                            AutomationProperties.Name="{x:Static loc:Texts.UiMinVolume}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Editor.MinPercent, StringFormat={}{0:0} %}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <Grid Margin="0,6,0,0" ToolTip="{x:Static loc:Texts.UiMaxVolume}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="48" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="Speaker220" FontSize="16" Foreground="{StaticResource MutedText}" VerticalAlignment="Center" />
                                    <Slider x:Name="MaxVolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding Editor.MaxPercent}" VerticalAlignment="Center" AutomationProperties.AutomationId="MaxVolumeSlider"
                                            AutomationProperties.Name="{x:Static loc:Texts.UiMaxVolume}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Editor.MaxPercent, StringFormat={}{0:0} %}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>

                            <!-- Medienbefehl -->
                            <StackPanel Visibility="{Binding Editor.IsMedia, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{x:Static loc:Texts.UiMediaCommandLabel}" Style="{StaticResource SectionLabel}" />
                                <ComboBox x:Name="MediaPicker" ItemsSource="{Binding Editor.MediaOptions}" DisplayMemberPath="Text" SelectedValuePath="Value"
                                          SelectedValue="{Binding Editor.Media, Mode=TwoWay}" AutomationProperties.AutomationId="MediaPicker"
                                          AutomationProperties.Name="{x:Static loc:Texts.UiMediaCommandLabel}" />
                            </StackPanel>

                            <!-- Tastenkombination -->
                            <StackPanel Visibility="{Binding Editor.IsHotkey, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{x:Static loc:Texts.KindNameHotkey}" Style="{StaticResource SectionLabel}" />
                                <ui:TextBox x:Name="HotkeyBox" Text="{Binding Editor.HotkeyText, UpdateSourceTrigger=PropertyChanged}"
                                            Icon="{ui:SymbolIcon Keyboard20}" PlaceholderText="{x:Static loc:Texts.UiHotkeyPlaceholder}"
                                            ToolTip="{x:Static loc:Texts.UiHotkeyTip}" AutomationProperties.AutomationId="HotkeyBox"
                                            AutomationProperties.Name="{x:Static loc:Texts.KindNameHotkey}" />
                            </StackPanel>

                            <!-- Audiogerät wechseln -->
                            <StackPanel x:Name="SwitchSection" Visibility="{Binding Editor.IsSwitchDevice, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{x:Static loc:Texts.UiSwitchFlowLabel}" Style="{StaticResource SectionLabel}" />
                                <ComboBox x:Name="SwitchFlowPicker" ItemsSource="{Binding Editor.SwitchFlowOptions}" DisplayMemberPath="Text" SelectedValuePath="Value"
                                          SelectedValue="{Binding Editor.SwitchFlow, Mode=TwoWay}" AutomationProperties.AutomationId="SwitchFlowPicker"
                                          AutomationProperties.Name="{x:Static loc:Texts.UiSwitchFlowLabel}" />
                                <DockPanel Margin="2,16,0,6">
                                    <Button x:Name="RefreshDevicesButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28"
                                            Command="{Binding RefreshAppsCommand}" ToolTip="{x:Static loc:Texts.UiRefreshLists}"
                                            AutomationProperties.AutomationId="RefreshDevicesButton" AutomationProperties.Name="{x:Static loc:Texts.UiRefreshLists}">
                                        <ui:SymbolIcon Symbol="ArrowSync20" FontSize="14" />
                                    </Button>
                                    <TextBlock Text="{x:Static loc:Texts.UiSwitchDevicesLabel}" Style="{StaticResource SectionLabel}" Margin="0" VerticalAlignment="Center" />
                                </DockPanel>
                                <ItemsControl x:Name="DeviceChoiceList" ItemsSource="{Binding Editor.DeviceChoices}" Focusable="False"
                                              AutomationProperties.AutomationId="DeviceChoiceList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{x:Static loc:Texts.UiNoDevicesListed}" Style="{StaticResource Hint}"
                                           Visibility="{Binding Editor.HasNoDevices, Converter={StaticResource BoolToVis}}" />
                                <TextBlock x:Name="SwitchHint" Text="{x:Static loc:Texts.UiSwitchHint}" Style="{StaticResource Hint}" Margin="2,8,0,0"
                                           AutomationProperties.AutomationId="SwitchHint" />
                            </StackPanel>

                            <!-- Aktionen, die dieser Editor nicht zeigen kann, bleiben erhalten -->
                            <Border x:Name="KeptActionsPanel" Visibility="{Binding Editor.HasKeptActions, Converter={StaticResource BoolToVis}}"
                                    Margin="0,14,0,0" Padding="10,8" CornerRadius="10" Background="{StaticResource SubtleFillBrush}"
                                    BorderBrush="{StaticResource CardStrokeBrush}" BorderThickness="1">
                                <DockPanel>
                                    <Button x:Name="DropKeptActionsButton" DockPanel.Dock="Right" Style="{StaticResource IconButtonDanger}" VerticalAlignment="Top"
                                            Command="{Binding Editor.DropKeptActionsCommand}" ToolTip="{x:Static loc:Texts.UiDropKeptActions}"
                                            AutomationProperties.AutomationId="DropKeptActionsButton" AutomationProperties.Name="{x:Static loc:Texts.UiDropKeptActions}">
                                        <ui:SymbolIcon Symbol="Delete20" />
                                    </Button>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Editor.KeptActionsText}" Style="{StaticResource Hint}" />
                                        <ItemsControl ItemsSource="{Binding Editor.KeptActions}" Margin="0,4,0,0" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Eigener Name -->
                            <ui:TextBox x:Name="MappingNameBox" Margin="0,18,0,0" Text="{Binding Editor.Name, UpdateSourceTrigger=PropertyChanged}"
                                        Icon="{ui:SymbolIcon Tag20}" PlaceholderText="{x:Static loc:Texts.UiMappingNamePlaceholder}"
                                        ToolTip="{x:Static loc:Texts.UiMappingNameTip}" AutomationProperties.AutomationId="MappingNameBox"
                                        AutomationProperties.Name="{x:Static loc:Texts.UiMappingNamePlaceholder}" />

                            <TextBlock x:Name="ValidationText" Text="{Binding Editor.ValidationMessage}" TextWrapping="Wrap" Margin="2,12,0,0" FontSize="12"
                                       Foreground="{StaticResource DangerBrush}" AutomationProperties.AutomationId="ValidationText"
                                       Visibility="{Binding Editor.HasValidationMessage, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Fuß: Übernehmen-Leiste (nur bei Änderungen) und Entfernen -->
                    <Grid Grid.Row="2" Margin="12,4,12,12" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="ApplyBar" Grid.Column="0" CornerRadius="12" Padding="6" Margin="0,0,8,0" BorderThickness="1"
                                AutomationProperties.AutomationId="ApplyBar">
                            <Border.RenderTransform>
                                <TranslateTransform />
                            </Border.RenderTransform>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Background" Value="{StaticResource SubtleFillBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource CardStrokeBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Editor.IsDirty}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18" />
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                         From="10" To="0" Duration="0:0:0.18" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Editor.CanApply}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:Button x:Name="ApplyButton" Content="{x:Static loc:Texts.UiApply}" Icon="{ui:SymbolIcon Checkmark20}" Appearance="Primary"
                                           Height="38" FontWeight="SemiBold" HorizontalAlignment="Stretch" Command="{Binding ApplyCommand}"
                                           ToolTip="{x:Static loc:Texts.UiApplyTip}" AutomationProperties.AutomationId="ApplyButton" />
                                <ui:Button x:Name="DiscardButton" Grid.Column="1" Content="{x:Static loc:Texts.UiDiscard}" Icon="{ui:SymbolIcon ArrowUndo20}"
                                           Height="38" Margin="6,0,0,0" Appearance="Transparent" Command="{Binding DiscardCommand}"
                                           ToolTip="{x:Static loc:Texts.UiDiscardTip}" AutomationProperties.AutomationId="DiscardButton" />
                            </Grid>
                        </Border>
                        <Button x:Name="RemoveButton" Grid.Column="1" Style="{StaticResource IconButtonDanger}" Width="40" Height="40" FontSize="18"
                                VerticalAlignment="Center" Command="{Binding RemoveCommand}" ToolTip="{x:Static loc:Texts.UiRemoveMapping}"
                                AutomationProperties.AutomationId="RemoveButton" AutomationProperties.Name="{x:Static loc:Texts.UiRemoveMapping}">
                            <ui:SymbolIcon Symbol="Delete20" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Statuszeile und Fehlerleiste (nur wenn nötig) -->
        <StackPanel Grid.Row="3" Margin="16,0,16,10">
            <Border x:Name="ErrorBar" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" CornerRadius="10" Padding="12,6,6,6" Margin="0,0,0,6"
                    Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}" AutomationProperties.AutomationId="ErrorBar">
                <DockPanel>
                    <ui:SymbolIcon DockPanel.Dock="Left" Symbol="ErrorCircle20" FontSize="18" Foreground="{StaticResource DangerBrush}" Margin="0,0,10,0"
                                   VerticalAlignment="Center" />
                    <Button x:Name="DismissErrorButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding DismissErrorCommand}"
                            ToolTip="{x:Static loc:Texts.UiClose}" AutomationProperties.AutomationId="DismissErrorButton"
                            AutomationProperties.Name="{x:Static loc:Texts.UiClose}">
                        <ui:SymbolIcon Symbol="Dismiss20" />
                    </Button>
                    <TextBlock x:Name="ErrorText" Text="{Binding ErrorMessage}" TextWrapping="Wrap" VerticalAlignment="Center"
                               AutomationProperties.AutomationId="ErrorText" />
                </DockPanel>
            </Border>
            <TextBlock x:Name="StatusText" Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" FontSize="12" Margin="4,0,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" ToolTip="{Binding StatusMessage}"
                       AutomationProperties.AutomationId="StatusText" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
