<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Stil "Rack" (erzeugt; alle Schlüssel müssen in jeder Stil-Datei stehen) -->
    <Color x:Key="AccentColor">#1F6FD1</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#1F6FD1" />
    <SolidColorBrush x:Key="AccentStrongBrush" Color="#1556A8" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2E1F6FD1" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBrush" Color="#E9EBEE" />
    <SolidColorBrush x:Key="PopupBrush" Color="#F4F5F7" />
    <SolidColorBrush x:Key="CardStrokeBrush" Color="#AEB4BD" />
    <SolidColorBrush x:Key="SubtleFillBrush" Color="#0F1B1E24" />
    <SolidColorBrush x:Key="SubtleHoverBrush" Color="#1E1B1E24" />
    <SolidColorBrush x:Key="MutedText" Color="#5D6470" />
    <SolidColorBrush x:Key="DangerBrush" Color="#C62828" />
    <SolidColorBrush x:Key="InkBrush" Color="#1B1E24" />
    <SolidColorBrush x:Key="InkSecondaryBrush" Color="#464C57" />
    <SolidColorBrush x:Key="AppBackdropBrush" Color="#D6D9DE" />
    <LinearGradientBrush x:Key="WindowGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#DADDE2" Offset="0" />
            <GradientStop Color="#D2D5DB" Offset="0.5" />
            <GradientStop Color="#C4C8CF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BodyBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#D0D4DA" Offset="0" />
            <GradientStop Color="#B8BDC6" Offset="0.5" />
            <GradientStop Color="#9EA4AE" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="DeviceEdge" Color="#6A707A" />
    <SolidColorBrush x:Key="PrintBrush" Color="#1B1E24" />
    <SolidColorBrush x:Key="PrintSoftBrush" Color="#4A505A" />
    <SolidColorBrush x:Key="KeyGlyphBrush" Color="#1B1E24" />
    <LinearGradientBrush x:Key="KeyBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F4F6F9" Offset="0" />
            <GradientStop Color="#C9CED6" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="KeyActiveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0" />
            <GradientStop Color="#E3E7EC" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="KeyEdgeBrush" Color="#6A707A" />
    <SolidColorBrush x:Key="LedOffBrush" Color="#9AA9C0" />
    <SolidColorBrush x:Key="LedOnBrush" Color="#1F6FD1" />
    <SolidColorBrush x:Key="KnobMarkBrush" Color="#F2F4F7" />
    <RadialGradientBrush x:Key="KnobBrush" GradientOrigin="0.38,0.3" Center="0.5,0.5" RadiusX="0.65" RadiusY="0.65">
            <GradientStop Color="#5A606B" Offset="0" />
            <GradientStop Color="#2B2F36" Offset="0.6" />
            <GradientStop Color="#14161A" Offset="1" />
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="FaderCapBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F4F6F9" Offset="0" />
            <GradientStop Color="#C9CED6" Offset="0.5" />
            <GradientStop Color="#98A0AC" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SlotBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#2B2F36" Offset="0" />
            <GradientStop Color="#14161A" Offset="0.5" />
            <GradientStop Color="#2B2F36" Offset="1" />
    </LinearGradientBrush>
    <CornerRadius x:Key="CardRadius">4</CornerRadius>
    <CornerRadius x:Key="PopupRadius">4</CornerRadius>
    <CornerRadius x:Key="ControlRadius">3</CornerRadius>
    <CornerRadius x:Key="KeyRadius">3</CornerRadius>
    <CornerRadius x:Key="BodyRadius">5</CornerRadius>
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <!-- Überschreibt die Systemfarben von WPF-UI, damit Texte zum Stil passen -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#1B1E24" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#464C57" />
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#D6D9DE" />
</ResourceDictionary>
