<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Stil "Minimal" (erzeugt; alle Schlüssel müssen in jeder Stil-Datei stehen) -->
    <Color x:Key="AccentColor">#111111</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#111111" />
    <SolidColorBrush x:Key="AccentStrongBrush" Color="#000000" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#14111111" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBrush" Color="#F6F6F6" />
    <SolidColorBrush x:Key="PopupBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardStrokeBrush" Color="#DCDCDC" />
    <SolidColorBrush x:Key="SubtleFillBrush" Color="#0A000000" />
    <SolidColorBrush x:Key="SubtleHoverBrush" Color="#18000000" />
    <SolidColorBrush x:Key="MutedText" Color="#777777" />
    <SolidColorBrush x:Key="DangerBrush" Color="#D32F2F" />
    <SolidColorBrush x:Key="InkBrush" Color="#111111" />
    <SolidColorBrush x:Key="InkSecondaryBrush" Color="#555555" />
    <SolidColorBrush x:Key="AppBackdropBrush" Color="#FFFFFF" />
    <LinearGradientBrush x:Key="WindowGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0" />
            <GradientStop Color="#FFFFFF" Offset="0.5" />
            <GradientStop Color="#F7F7F7" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BodyBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F4F4F4" Offset="0" />
            <GradientStop Color="#EEEEEE" Offset="0.5" />
            <GradientStop Color="#E6E6E6" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="DeviceEdge" Color="#BDBDBD" />
    <SolidColorBrush x:Key="PrintBrush" Color="#111111" />
    <SolidColorBrush x:Key="PrintSoftBrush" Color="#777777" />
    <SolidColorBrush x:Key="KeyGlyphBrush" Color="#111111" />
    <LinearGradientBrush x:Key="KeyBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0" />
            <GradientStop Color="#EDEDED" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="KeyActiveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0" />
            <GradientStop Color="#E0E0E0" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="KeyEdgeBrush" Color="#B5B5B5" />
    <SolidColorBrush x:Key="LedOffBrush" Color="#E6BDBA" />
    <SolidColorBrush x:Key="LedOnBrush" Color="#E5322D" />
    <SolidColorBrush x:Key="KnobMarkBrush" Color="#FFFFFF" />
    <RadialGradientBrush x:Key="KnobBrush" GradientOrigin="0.38,0.3" Center="0.5,0.5" RadiusX="0.65" RadiusY="0.65">
            <GradientStop Color="#4A4A4A" Offset="0" />
            <GradientStop Color="#1E1E1E" Offset="0.6" />
            <GradientStop Color="#0A0A0A" Offset="1" />
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="FaderCapBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#4A4A4A" Offset="0" />
            <GradientStop Color="#1E1E1E" Offset="0.5" />
            <GradientStop Color="#0A0A0A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SlotBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#D4D4D4" Offset="0" />
            <GradientStop Color="#EDEDED" Offset="0.5" />
            <GradientStop Color="#D4D4D4" Offset="1" />
    </LinearGradientBrush>
    <CornerRadius x:Key="CardRadius">10</CornerRadius>
    <CornerRadius x:Key="PopupRadius">10</CornerRadius>
    <CornerRadius x:Key="ControlRadius">6</CornerRadius>
    <CornerRadius x:Key="KeyRadius">5</CornerRadius>
    <CornerRadius x:Key="BodyRadius">12</CornerRadius>
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <!-- Überschreibt die Systemfarben von WPF-UI, damit Texte zum Stil passen -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#111111" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#555555" />
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#FFFFFF" />
</ResourceDictionary>
