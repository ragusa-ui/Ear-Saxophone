<ui:FluentWindow x:Class="EarSaxophone.App.MainWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:local="clr-namespace:EarSaxophone.App"
                  Title="Ear Saxophone"
                  Width="1280" Height="860" MinWidth="1120" MinHeight="720"
                  WindowStartupLocation="CenterScreen"
                  ExtendsContentIntoTitleBar="True"
                  WindowBackdropType="None"
                  Background="{DynamicResource ApplicationBackgroundBrush}"
                  Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelLearnCommand}" />
    </ui:FluentWindow.InputBindings>

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <SolidColorBrush x:Key="AccentBrush" Color="#3FB6A8" />
        <SolidColorBrush x:Key="TileBorder" Color="#2EFFFFFF" />
        <SolidColorBrush x:Key="TileBorderMapped" Color="#66FFFFFF" />
        <SolidColorBrush x:Key="TileBackground" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="TileBackgroundHover" Color="#24FFFFFF" />

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="2,10,0,4" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <LinearGradientBrush x:Key="BodyBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2D3347" Offset="0" />
            <GradientStop Color="#171A26" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="KeyBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#454D66" Offset="0" />
            <GradientStop Color="#2C3248" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="KeyActiveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#66E0CF" Offset="0" />
            <GradientStop Color="#2F9E91" Offset="1" />
        </LinearGradientBrush>
        <RadialGradientBrush x:Key="KnobBrush" GradientOrigin="0.35,0.3" Center="0.5,0.5" RadiusX="0.7" RadiusY="0.7">
            <GradientStop Color="#5C6782" Offset="0" />
            <GradientStop Color="#252A3B" Offset="1" />
        </RadialGradientBrush>
        <SolidColorBrush x:Key="TrackBrush" Color="#0D1018" />
        <SolidColorBrush x:Key="DeviceEdge" Color="#3E475F" />
        <SolidColorBrush x:Key="MutedText" Color="#8D96AE" />

        <Style x:Key="ElementButton" TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="14" BorderThickness="2" BorderBrush="Transparent"
                                Background="Transparent" Padding="3">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1CFFFFFF" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Root" Property="Background" Value="#2A3FB6A8" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="KnobTemplate">
            <Button Style="{StaticResource ElementButton}" Width="{Binding Width}" Height="{Binding Height}"
                    ToolTip="{Binding TooltipText}" Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
                <Grid>
                    <Ellipse Fill="{StaticResource KnobBrush}" Stroke="#4A546E" StrokeThickness="1.5" />
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <RotateTransform Angle="{Binding KnobAngle}" />
                        </Grid.RenderTransform>
                        <Border Width="4" Height="17" Margin="0,5,0,0" VerticalAlignment="Top" HorizontalAlignment="Center"
                                CornerRadius="2" Background="{StaticResource AccentBrush}" />
                    </Grid>
                    <Ellipse Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0"
                             Fill="{StaticResource AccentBrush}" Stroke="#171A26" StrokeThickness="1.5"
                             Visibility="{Binding HasMapping, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="FaderTemplate">
            <Button Style="{StaticResource ElementButton}" Width="{Binding Width}" Height="{Binding Height}"
                    ToolTip="{Binding TooltipText}" Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
                <Grid>
                    <Border Width="8" HorizontalAlignment="Center" Margin="0,10,0,26" CornerRadius="4"
                            Background="{StaticResource TrackBrush}" BorderBrush="#2A3045" BorderThickness="1" />
                    <Border Width="32" Height="22" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0" CornerRadius="5"
                            Background="{StaticResource KeyBrush}" BorderBrush="#5A647F" BorderThickness="1">
                        <Border.RenderTransform>
                            <TranslateTransform Y="{Binding CapOffset}" />
                        </Border.RenderTransform>
                        <Rectangle Height="2" Margin="6,0" Fill="{StaticResource AccentBrush}" />
                    </Border>
                    <TextBlock Text="{Binding Caption}" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontSize="12"
                               FontWeight="SemiBold" Foreground="{StaticResource MutedText}" />
                    <Ellipse Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0"
                             Fill="{StaticResource AccentBrush}" Stroke="#171A26" StrokeThickness="1.5"
                             Visibility="{Binding HasMapping, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="KeyTemplate">
            <Button Style="{StaticResource ElementButton}" Width="{Binding Width}" Height="{Binding Height}"
                    ToolTip="{Binding TooltipText}" Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
                <Grid>
                    <Border x:Name="Key" CornerRadius="8" Background="{StaticResource KeyBrush}" BorderBrush="#5A647F" BorderThickness="1">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Glyph}" Foreground="{Binding GlyphColor}" FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Caption}" FontSize="8.5" Foreground="{StaticResource MutedText}" HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Ellipse Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0"
                             Fill="{StaticResource AccentBrush}" Stroke="#171A26" StrokeThickness="1.5"
                             Visibility="{Binding HasMapping, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="Key" Property="Background" Value="{StaticResource KeyActiveBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <local:ElementTemplateSelector x:Key="ElementSelector" Knob="{StaticResource KnobTemplate}"
                                       Fader="{StaticResource FaderTemplate}" Button="{StaticResource KeyTemplate}" />

        <Style x:Key="Chip" TargetType="Button">
            <Setter Property="Margin" Value="3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="15" BorderThickness="1" Padding="12,5"
                                Background="{StaticResource TileBackground}" BorderBrush="{StaticResource TileBorder}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource TileBackgroundHover}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ChipTemplate">
            <Button Style="{StaticResource Chip}" ToolTip="{Binding TooltipText}"
                    Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Margin="0,0,8,0" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ListText}" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="WindowTitleBar" Grid.Row="0" Title="Ear Saxophone" />

        <!-- Kopfzeile: Zeile 1 Verbindung und MIDI-Learn, Zeile 2 Profile -->
        <StackPanel Grid.Row="1" Margin="20,8,20,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="11" Height="11" Margin="0,0,9,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#C75050" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="#4CC38A" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding ConnectionText}" TextWrapping="Wrap" MaxWidth="560" VerticalAlignment="Center" FontSize="13" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="Abbrechen" Margin="0,0,8,0" Command="{Binding CancelLearnCommand}"
                               Visibility="{Binding IsLearning, Converter={StaticResource BoolToVis}}" />
                    <ui:Button Content="Neu verbinden" Margin="0,0,8,0" Command="{Binding ReconnectCommand}"
                               ToolTip="Gerät neu öffnen, falls es nach Ruhezustand oder kurzem Abziehen nicht mehr reagiert" />
                    <ui:Button Content="Regler wählen (MIDI-Learn)" Appearance="Primary" Command="{Binding LearnCommand}"
                               ToolTip="Danach einen Regler oder eine Taste am Gerät bewegen oder drücken" />
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="Profil" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ComboBox ItemsSource="{Binding ProfileNames}" SelectedItem="{Binding ActiveProfileName, Mode=TwoWay}" MinWidth="170" />
                <TextBlock Text="Name" VerticalAlignment="Center" Margin="16,0,8,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBox Text="{Binding ProfileNameEdit, UpdateSourceTrigger=LostFocus}" MinWidth="170"
                         ToolTip="Name des Profils ändern (mit Enter oder durch Verlassen des Feldes bestätigen)" />
                <ui:Button Content="Neues Profil" Margin="12,0,0,0" Command="{Binding NewProfileCommand}" />
                <ui:Button Content="Profil löschen" Margin="6,0,0,0" Command="{Binding DeleteProfileCommand}" />
            </StackPanel>
        </StackPanel>

        <!-- Hauptbereich: Übersicht links, Editor rechts -->
        <Grid Grid.Row="2" Margin="20,4,20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Visibility="{Binding IsLearning, Converter={StaticResource BoolToVis}}" Padding="12,9" Margin="0,4,12,0"
                        CornerRadius="8" Background="#333FB6A8" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                    <TextBlock Text="{Binding LearnHint}" TextWrapping="Wrap" />
                </Border>

                <!-- Das Gerät als Bild: antippen, was belegt werden soll -->
                <Viewbox Grid.Row="1" Stretch="Uniform" Margin="0,10,14,10">
                    <Grid Width="1000" Height="460">
                        <Border CornerRadius="28" Background="{StaticResource BodyBrush}" BorderBrush="{StaticResource DeviceEdge}" BorderThickness="1.5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="32" ShadowDepth="10" Opacity="0.5" Color="Black" />
                            </Border.Effect>
                        </Border>
                        <Canvas>
                            <Rectangle Canvas.Left="288" Canvas.Top="38" Width="2" Height="384" RadiusX="1" RadiusY="1" Fill="#22FFFFFF" />
                            <TextBlock Canvas.Left="36" Canvas.Top="392" Text="nanoKONTROL2" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedText}" />
                        </Canvas>
                        <ItemsControl ItemsSource="{Binding Elements}" ItemTemplateSelector="{StaticResource ElementSelector}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>
                    </Grid>
                </Viewbox>

                <ScrollViewer Grid.Row="2" MaxHeight="120" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Belegungen" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Noch nichts belegt. Tippe im Bild auf einen Regler oder eine Taste.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MappedElements.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding MappedElements}" ItemTemplate="{StaticResource ChipTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <StackPanel Visibility="{Binding HasExtraElements, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Weitere Regler (per MIDI-Learn erkannt, nicht im Bild)" Style="{StaticResource SectionTitle}" />
                            <ItemsControl ItemsSource="{Binding ExtraElements}" ItemTemplate="{StaticResource ChipTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Editor -->
            <Border Grid.Column="1" CornerRadius="10" Padding="16,12" Margin="0,4,0,0"
                    Background="{StaticResource TileBackground}"
                    BorderBrush="{StaticResource TileBorder}" BorderThickness="1">
                <Grid>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Top"
                               Text="Tippe links im Bild auf einen Regler, eine Taste oder einen Fader. Oder klicke auf MIDI-Learn und bewege ihn am Gerät. Danach legst du hier fest, was er tun soll.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="{Binding SelectedElement.Label}" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedElement.Control}" Style="{StaticResource Hint}" />

                            <TextBlock Text="Aktion" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding Editor.KindOptions}" DisplayMemberPath="Text" SelectedValuePath="Value"
                                      SelectedValue="{Binding Editor.Kind, Mode=TwoWay}" />

                            <StackPanel Visibility="{Binding Editor.IsAudio, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Ziel" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding Editor.TargetOptions}" DisplayMemberPath="Text" SelectedValuePath="Value"
                                          SelectedValue="{Binding Editor.Target, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding Editor.IsApplication, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Programmdatei der Anwendung" Style="{StaticResource FieldLabel}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox IsEditable="True" ItemsSource="{Binding Editor.AvailableApps}"
                                              Text="{Binding Editor.AppName, UpdateSourceTrigger=PropertyChanged}" />
                                    <ui:Button Grid.Column="1" Content="Aktualisieren" Margin="8,0,0,0" Command="{Binding RefreshAppsCommand}" />
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Zum Beispiel Discord.exe. Die Liste zeigt Programme, die gerade Audio nutzen. Der Name kann auch eingetragen werden, wenn das Programm noch nicht läuft. Alle Fenster und Prozesse des Programms werden gemeinsam geregelt." />
                            </StackPanel>

                            <StackPanel Visibility="{Binding Editor.IsVolume, Converter={StaticResource BoolToVis}}">
                                <CheckBox Content="Umkehren (oben = leise)" IsChecked="{Binding Editor.Invert}" Margin="0,12,0,0" />
                                <TextBlock Text="Kleinste Lautstärke" Style="{StaticResource FieldLabel}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="52" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Editor.MinPercent}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Editor.MinPercent, StringFormat={}{0:0} %}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="Größte Lautstärke" Style="{StaticResource FieldLabel}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="52" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Editor.MaxPercent}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Editor.MaxPercent, StringFormat={}{0:0} %}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Visibility="{Binding Editor.IsMedia, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Befehl" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding Editor.MediaOptions}" DisplayMemberPath="Text" SelectedValuePath="Value"
                                          SelectedValue="{Binding Editor.Media, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Sendet die systemweite Medientaste. Windows entscheidet, welches Programm sie erhält (zum Beispiel Spotify oder ein Browser-Tab)." />
                            </StackPanel>

                            <StackPanel Visibility="{Binding Editor.IsHotkey, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Tastenkombination" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Editor.HotkeyText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Zum Beispiel Strg+Alt+M, Win+D oder Strg+Umschalt+Esc. Sie wirkt auf das Programm, das gerade im Vordergrund ist." />
                            </StackPanel>

                            <TextBlock Text="{Binding Editor.ValidationMessage}" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="#FF7B72"
                                       Visibility="{Binding Editor.HasValidationMessage, Converter={StaticResource BoolToVis}}" />

                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <ui:Button Content="Übernehmen" Appearance="Primary" Command="{Binding ApplyCommand}" />
                                <ui:Button Content="Testen" Margin="8,0,0,0" Command="{Binding TestCommand}" />
                                <ui:Button Content="Entfernen" Margin="8,0,0,0" Command="{Binding RemoveCommand}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Testen führt die Aktion einmal aus (Lautstärke auf 50 %), ohne zu speichern." />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Fußzeile: Fehler, Status, Einstellungen -->
        <StackPanel Grid.Row="3" Margin="20,0,20,14">
            <Border Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" CornerRadius="8" Padding="14,10" Margin="0,0,0,10"
                    Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <ui:Button Grid.Column="1" Content="Schließen" Margin="12,0,0,0" Command="{Binding DismissErrorCommand}" />
                </Grid>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:ToggleSwitch Content="Mit Windows starten" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" Margin="0,0,22,0" />
                    <ui:ToggleSwitch Content="Im Infobereich bleiben" IsChecked="{Binding KeepInTray, Mode=TwoWay}" Margin="0,0,22,0" />
                    <ui:ToggleSwitch Content="Minimiert starten" IsChecked="{Binding StartMinimized, Mode=TwoWay}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
